//! name — printing a name as tree does (C aspen `src/render/name.c`,
//! "faithful to tree's printit()"), with `-q` (a non-printable character
//! as `?`), `-N` (every byte as it is) and `-Q` (double quotes around the
//! name, a quote inside escaped, a space not).
//!
//! In the C locale (one byte per character) a name goes through the BYTE
//! branch (`src/render/name.c:20`): BEL..CR as `\a`..`\r`, a backslash
//! and a space escaped with a backslash, the other printable ASCII bytes
//! as they are, and every other byte as a three-digit octal escape. In a
//! UTF-8 locale it goes through the WIDE branch (`:70`): an all-ASCII
//! name prints its printable bytes as they are and the rest in octal; a
//! name that decodes as UTF-8 prints each printable character as it is
//! and each other one as the octal of its code point; a name that does
//! not decode falls back to the byte branch.
//!
//! "Printable" for a code point is glibc's `iswprint` in its UTF-8
//! locales, approximated here as: not a C0 or C1 control, not DEL, not
//! U+2028/U+2029. Every golden and fuzzer name (é, ï, 日本語, controls,
//! DEL) is decided the same way by both; an unassigned code point, which
//! glibc does not count as printable, is the approximation's known edge.

use out

/// `\%03lo` (`src/render/name.c:12`): a backslash and the value in
/// octal, at least three digits.
fn octal(mut o: out.Out, v: int) {
    var ds = List[int]()
    var x = v
    while x > 0 || ds.len < 3 {
        (mut ds).push(x % 8)
        x = x / 8
    }
    out.c(mut o, 92)
    var k = ds.len - 1
    while k >= 0 {
        out.c(mut o, 48 + ds[k])
        k -= 1
    }
}

/// `-Q` (`NP_QUOTE`, `src/render/name.h:14`).
pub fn f_quote() -> int {
    1
}

/// `-N` (`NP_NOPRINT`).
pub fn f_noprint() -> int {
    2
}

/// `-q` (`NP_QMARK`).
pub fn f_qmark() -> int {
    4
}

/// The flags `-q`, `-N` and `-Q` set (`src/render/unix.c:23`).
pub fn flags_of(quote: bool, noprint: bool, qmark: bool) -> int {
    var f = 0
    if quote {
        f = f | 1
    }
    if noprint {
        f = f | 2
    }
    if qmark {
        f = f | 4
    }
    f
}

fn byte_branch(mut o: out.Out, s: List[byte], from: int, to: int, utf8: bool, flags: int) {
    let quote = flags & 1 != 0
    let qmark = flags & 4 != 0
    var i = from
    while i < to {
        let c = s[i] as int
        if c > 32 && c < 127 && c != 92 && c != 34 {
            (mut o.buf).push(s[i])
        } else if c >= 7 && c <= 13 || c == 92 || c == 34 && quote || c == 32 && !quote {
            (mut o.buf).push(92 as byte)
            if c > 13 {
                (mut o.buf).push(s[i])
            } else {
                out.s(mut o, "abtnvfr"[c - 7..c - 6])
            }
        } else if c >= 32 && c < 127 {
            (mut o.buf).push(s[i])
        } else if qmark {
            // tree keeps a high byte under -q in a multibyte locale
            if utf8 && c > 127 {
                (mut o.buf).push(s[i])
            } else {
                (mut o.buf).push(63 as byte)
            }
        } else {
            octal(mut o, c)
        }
        i += 1
    }
}

fn wprint(cp: int) -> bool {
    if cp < 32 || cp >= 127 && cp < 160 {
        return false
    }
    cp != 8232 && cp != 8233
}

/// The code point at `s[i]` and its length in bytes, or length 0 when
/// the bytes there are not well-formed UTF-8 (what `mbstowcs` refuses:
/// a stray continuation byte, an overlong form, a surrogate, past
/// U+10FFFF, a truncated sequence).
fn decode(s: List[byte], i: int, to: int) -> (int, int) {
    let c = s[i] as int
    if c < 128 {
        return (c, 1)
    }
    var need = 0
    var cp = 0
    var lowest = 0
    if c >= 194 && c <= 223 {
        need = 1
        cp = c - 192
        lowest = 128
    } else if c >= 224 && c <= 239 {
        need = 2
        cp = c - 224
        lowest = 2048
    } else if c >= 240 && c <= 244 {
        need = 3
        cp = c - 240
        lowest = 65536
    } else {
        return (0, 0)
    }
    if i + need >= to {
        return (0, 0)
    }
    var k = 1
    while k <= need {
        let d = s[i + k] as int
        if d < 128 || d > 191 {
            return (0, 0)
        }
        cp = cp * 64 + (d - 128)
        k += 1
    }
    if cp < lowest || cp > 1114111 || cp >= 55296 && cp <= 57343 {
        return (0, 0)
    }
    (cp, need + 1)
}

/// Print `s[from..to]` as tree prints a name (`src/render/name.c:61`);
/// `utf8` is a UTF-8 locale, `flags` the `-q`/`-N`/`-Q` set.
pub fn put(mut o: out.Out, s: List[byte], from: int, to: int, utf8: bool) {
    put_flags(mut o, s, from, to, utf8, 0)
}

/// `put` with `-q`/`-N`/`-Q`'s flags.
pub fn put_flags(mut o: out.Out, s: List[byte], from: int, to: int, utf8: bool, flags: int) {
    let quote = flags & 1 != 0
    if flags & 2 != 0 {
        if quote {
            (mut o.buf).push(34 as byte)
        }
        out.bytes(mut o, s, from, to)
        if quote {
            (mut o.buf).push(34 as byte)
        }
        return
    }
    if !utf8 {
        if quote {
            (mut o.buf).push(34 as byte)
        }
        byte_branch(mut o, s, from, to, false, flags)
        if quote {
            (mut o.buf).push(34 as byte)
        }
        return
    }
    let qmark = flags & 4 != 0
    var ascii = true
    var i = from
    while i < to {
        if s[i] as int >= 128 {
            ascii = false
            break
        }
        i += 1
    }
    if ascii {
        if quote {
            (mut o.buf).push(34 as byte)
        }
        i = from
        while i < to {
            let c = s[i] as int
            if c >= 32 && c < 127 {
                (mut o.buf).push(s[i])
            } else if qmark {
                (mut o.buf).push(63 as byte)
            } else {
                octal(mut o, c)
            }
            i += 1
        }
        if quote {
            (mut o.buf).push(34 as byte)
        }
        return
    }
    // decode the whole name first: one bad sequence sends it all to the
    // byte branch (`mbstowcs` fails as a whole, `src/render/name.c:96`)
    i = from
    while i < to {
        let (_, n) = decode(s, i, to)
        if n == 0 {
            if quote {
                (mut o.buf).push(34 as byte)
            }
            byte_branch(mut o, s, from, to, true, flags)
            if quote {
                (mut o.buf).push(34 as byte)
            }
            return
        }
        i += n
    }
    if quote {
        (mut o.buf).push(34 as byte)
    }
    i = from
    while i < to {
        let (cp, n) = decode(s, i, to)
        if wprint(cp) {
            out.bytes(mut o, s, i, i + n)
        } else if qmark {
            (mut o.buf).push(63 as byte)
        } else {
            octal(mut o, cp)
        }
        i += n
    }
    if quote {
        (mut o.buf).push(34 as byte)
    }
}

/// `put` for a `str` (a root path, a link target already decoded).
pub fn put_str(mut o: out.Out, t: str, utf8: bool) {
    put_str_flags(mut o, t, utf8, 0)
}

/// `put_flags` for a `str`.
pub fn put_str_flags(mut o: out.Out, t: str, utf8: bool, flags: int) {
    var b = List[byte]()
    for x in t.bytes() {
        (mut b).push(x)
    }
    put_flags(mut o, b, 0, b.len, utf8, flags)
}
