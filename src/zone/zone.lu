//! zone — the time zone `-D` and `--timefmt` print in, through wolf-std's
//! `std.time` (C aspen asks libc: `localtime_r` + `strftime`,
//! `src/render/fileinfo.c:52`). std reads the zone the way the C library
//! does: `TZ` unset is `/etc/localtime`; empty, or naming nothing it can
//! load, is UTC; `:file`, an absolute path, a name under `$TZDIR` (else
//! `/usr/share/zoneinfo`) or a POSIX rule otherwise (its `std/time/
//! local.lu` header).
//!
//! `TZ` is read once, at the start (`spelling`). std reads and parses the
//! zone file again on every lookup (no cache, its header), about 15 us a
//! call natively against 75 ns for a POSIX rule (ap02a, nomad), so `Memo`
//! keeps the last lookup of 64 slots by the second: the files of a
//! directory that share a time (a checkout, an unpacked archive) cost one.
//!
//! A leap-second zone (`right/`: a TZif file with leap records) is refused
//! by name (`refusal`). tree and C aspen apply its correction (27 s at
//! 2026-07-02); the std aspen pins refuses such a file and its `local`
//! turns that into UTC, so aspen refuses rather than print a wrong time.

use std.time

/// The zone's spelling for `time.local_in`: `$TZ` as it is, or the colon
/// path of `/etc/localtime` when it is unset (what std's `local` reads).
/// A value that is not UTF-8 names no zone, and tree prints it as UTC with
/// an empty name (measured): it is spelled `?`, which no zone and no rule
/// is, whose leading letters are none.
pub fn spelling() -> str {
    env_get("TZ") else |e| match e {
        missing => ":/etc/localtime",
        utf8 => "?",
    }
}

/// Local time at Unix second `t` in zone `tz` (a `spelling`): std's
/// answer, or UTC when std refuses the zone or cannot read it, as the C
/// library falls back and as std's own `local` does.
pub fn local_at(tz: str, t: int) -> time.Local {
    time.local_in(tz, t) else |_| {
        // the empty zone is UTC and reads nothing: it cannot fail
        time.local_in("", t) else |_| {
            time.Local {
                year: 1970,
                month: 1,
                day: 1,
                hour: 0,
                minute: 0,
                second: 0,
                nanos: 0,
                offset_s: 0,
                is_dst: false,
                abbrev: "UTC",
            }
        }
    }
}

/// Whether std reads zone `tz`.
fn reads(tz: str) -> bool {
    var ok = true
    let _ = time.local_in(tz, 0) else |_| {
        ok = false
        local_at("", 0)
    }
    ok
}

/// The name tree prints (`%Z`) for a zone nothing can load, at UTC: the
/// value's leading ASCII letters, one leading colon dropped (glibc 2.44
/// under tree 2.3.2, measured: `nonsense`, `Nowhere/City` -> `Nowhere`,
/// `:times/leap` -> `times`, a value that is not UTF-8 -> none).
fn lead_name(tz: str) -> str {
    let s = if tz.starts_with(":") then tz[1..] else tz
    var n = 0
    while n < s.len {
        let c = s.bytes()[n] as int
        if !(c >= 65 && c <= 90 || c >= 97 && c <= 122) {
            break
        }
        n += 1
    }
    s[0..n]
}

/// The zone aspen prints in, resolved once from a `spelling` the way the
/// C library resolves it (tree's answers, measured), then looked up by
/// std per second: the slots keep the last lookup of each of 64 seconds
/// (direct-mapped: exact, and small enough that the stat pool's per-task
/// copy of the columns stays cheap).
/// - std reads the zone: it, as it is.
/// - A POSIX DST rule given without its change dates (`XST3XDT`): std
///   guesses none, glibc takes the US one, as src/clock did:
///   `,M3.2.0,M11.1.0` is added.
/// - Nothing loads it: UTC, named as tree names it (`lead_name`); unset
///   or empty is UTC by name.
pub struct Memo {
    tz: str,
    named: bool,
    name: str,
    keys: List[int],
    vals: List[time.Local],
    used: List[bool],
}

/// A memo over zone `tz` (a `spelling`); its slots are made at the first
/// lookup.
pub fn memo(tz: str) -> Memo {
    var r = tz
    var named = false
    var name = ""
    if tz.len > 0 && !reads(tz) {
        let plain = (tz.find(",") else -1) < 0 && (tz.find("/") else -1) < 0 && !tz.starts_with(":")
        if plain && reads(tz + ",M3.2.0,M11.1.0") {
            r = tz + ",M3.2.0,M11.1.0"
        } else {
            r = ""
            if tz != ":/etc/localtime" {
                named = true
                name = lead_name(tz)
            }
        }
    }
    Memo {
        tz: r,
        named: named,
        name: name,
        keys: List[int](),
        vals: List[time.Local](),
        used: List[bool](),
    }
}

/// The local time of `t` in the memo's zone, from its slot when the slot
/// holds `t`.
pub fn at(mut m: Memo, t: int) -> time.Local {
    if m.used.len == 0 {
        var k = 0
        while k < 64 {
            (mut m.keys).push(0)
            (mut m.vals).push(local_at("", 0))
            (mut m.used).push(false)
            k += 1
        }
    }
    var s = t % 64
    if s < 0 {
        s += 64
    }
    if m.used[s] && m.keys[s] == t {
        return copy m.vals[s]
    }
    var l = local_at(m.tz, t)
    if m.named {
        l.abbrev = m.name
    }
    m.keys[s] = t
    m.vals[s] = copy l
    m.used[s] = true
    l
}

/// "" when aspen prints times in zone `tz` (a `spelling`), else the
/// diagnostic that refuses it: std refused the zone, and the file it would
/// have read is TZif with leap records. Any other refusal is UTC, as the
/// C library's (a name it cannot load, a malformed rule or file).
pub fn refusal(tz: str) -> str {
    if reads(tz) {
        return ""
    }
    let path = file_of(tz)
    if path.len == 0 || !leap_records(path) {
        return ""
    }
    let what = if tz == ":/etc/localtime" then "/etc/localtime" else "TZ={tz}"
    "aspen: {what}: not implemented in aspen (a leap-second zone, {path}: wolf-std's time zones cannot apply its leap seconds yet)\n"
}

/// The file std reads for zone `tz` (its `std/time/local.lu` `tz_named`):
/// one leading colon dropped; an absolute path as it is; with the colon,
/// a relative file that exists; else the name under `$TZDIR` or
/// `/usr/share/zoneinfo`. "" for the empty zone.
fn file_of(tz: str) -> str {
    var name = tz
    let colon = name.starts_with(":")
    if colon {
        name = name[1..]
    }
    if name.len == 0 {
        return ""
    }
    if name.starts_with("/") {
        return name
    }
    if colon && fs_is_file(name) {
        return name
    }
    let dir = env_get("TZDIR") else "/usr/share/zoneinfo"
    "{dir}/{name}"
}

fn be32(b: List[byte], at: int) -> int {
    var v = 0
    var k = 0
    while k < 4 {
        v = v * 256 + b[at + k] as int
        k += 1
    }
    v
}

/// Whether `path` is TZif (RFC 8536) with leap-second records in its
/// version-1 block or, from version 2, its 64-bit block (a `zic -b slim`
/// file has an empty version-1 block).
fn leap_records(path: str) -> bool {
    let b = fs_read_bytes(path) else |_| {
        return false
    }
    if b.len < 44 ||
        b[0] as int != 84 ||
        b[1] as int != 90 ||
        b[2] as int != 105 ||
        b[3] as int != 102 {
        return false
    }
    if be32(b, 28) != 0 {
        return true
    }
    if b[4] as int < 50 {
        return false
    }
    // the version-1 block: 4-byte times, a type index each, 6-byte types,
    // the designations, 8-byte leap records, the two indicator arrays
    let isut = be32(b, 20)
    let isstd = be32(b, 24)
    let n = be32(b, 32)
    let types = be32(b, 36)
    let chars = be32(b, 40)
    let at = 44 + n * 5 + types * 6 + chars + isstd + isut
    if at + 44 > b.len || b[at] as int != 84 || b[at + 1] as int != 90 {
        return false
    }
    be32(b, at + 28) != 0
}
