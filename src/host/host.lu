//! host — the two facts aspen asks of the host that wolf has no call
//! for: the machine's name (`--hyperlink`'s authority, C aspen's
//! `gethostname`, `src/render/unix.c:55`) and, on macOS, an account's
//! name that `/etc/passwd` does not hold (the directory service keeps
//! ordinary users there; wolf-std `std.os.users`' header advises the
//! host's own tool, `/usr/bin/id -un UID`).

/// The first line `argv`'s program prints on its standard output, or ""
/// when it cannot be started or prints nothing. The spawn builtins are
/// called directly (`os_pipe`, `os_spawn_fds`, `os_wait`, the calls
/// wolf-std `std.process` wraps): that module also reaches `std.net` for
/// its listener hand-off, a capability aspen has no other use for.
pub fn first_line(argv: List[str]) -> str {
    if argv.len == 0 {
        return ""
    }
    let (r, wfd) = os_pipe() else |_| {
        return ""
    }
    var args = List[str]()
    var i = 1
    while i < argv.len {
        (mut args).push(argv[i])
        i += 1
    }
    var started = true
    let slot = os_spawn_fds(argv[0], args, [1, wfd]) else |_| {
        started = false
        -1
    }
    fs_close(wfd) else |_| {}
    var got = List[byte]()
    if started {
        loop {
            let chunk = fs_read_chunk(r, 4096) else |_| {
                break
            }
            for x in chunk {
                (mut got).push(x)
            }
            if got.len > 65536 {
                break
            }
        }
    }
    fs_close(r) else |_| {}
    if started {
        let _ = os_wait(slot) else -1
    }
    var n = 0
    while n < got.len && got[n] as int != 10 {
        n += 1
    }
    str_from_utf8(got[0..n]) else ""
}

/// `gethostname`'s answer: linux's `/proc/sys/kernel/hostname` (the
/// UTS name, as the C call reads it), else what `/bin/hostname` prints.
pub fn name() -> str {
    let t = fs_read_text("/proc/sys/kernel/hostname") else |_| {
        return first_line(["/bin/hostname"])
    }
    t.trim_end()
}
