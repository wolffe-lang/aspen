//! text — the default listing (C aspen `src/render/unix.c`): indentation
//! lines at `--compress`'s width (or none, `-i`), the metadata column
//! (before the indentation under `--metafirst`), OSC 8 hyperlinks
//! (`--hyperlink`), colour, the name (or `-f`'s full path) as `-q`/`-N`/
//! `-Q` print it, `-F`'s suffix, a link's ` -> target`, the error
//! blurbs, `--info`'s comment lines, the report line.

use color
use ent
use host
use info
use lines
use name
use opts
use out

/// The text renderer's state: its writer, the locale's UTF-8-ness, the
/// line set and the active width's glyphs, which ancestors were last at
/// their depth, the columns, the colours, the name flags, and the OSC 8
/// link's parts.
pub struct Text {
    o: out.Out,
    utf8: bool,
    ln: lines.Lines,
    last: List[bool],
    pre: List[byte],
    pre_at: List[int],
    vert: List[byte],
    vleft: List[byte],
    corner: List[byte],
    space: List[byte],
    gap: bool,
    cols: info.Cols,
    colors: color.Colors,
    np: int,
    hyper: bool,
    scheme: str,
    authority: str,
    realbase: str,
    pathoffset: int,
    debug: bool,
}

fn bs(s: str) -> List[byte] {
    var b = List[byte]()
    for x in s.bytes() {
        (mut b).push(x)
    }
    b
}

/// A renderer writing to descriptor `fd` (`unix_ctx_init`,
/// `src/render/unix.c:19`).
pub fn new(
    fd: int,
    o: opts.Opts,
    utf8: bool,
    take ln: lines.Lines,
    take cols: info.Cols,
    take colors: color.Colors,
) -> Text {
    let cl = o.compress_indent
    let vert = copy ln.vert[cl]
    let vleft = copy ln.vleft[cl]
    let corner = copy ln.corner[cl]
    let spaces = ["   ", "  ", " "]
    var scheme = "file://"
    var authority = ""
    if o.hyperlink {
        // tree honours --scheme only when it holds a ':' (its other branch
        // never assigns it; `src/render/unix.c:47`)
        if o.has_scheme && o.scheme.contains(":") {
            scheme = o.scheme
        }
        if o.has_authority {
            authority = if o.authority == "." then "" else o.authority
        } else {
            authority = host.name()
        }
        if authority.len > 255 {
            authority = authority[0..255]
        }
    }
    Text {
        o: out.to_fd(fd),
        utf8: utf8,
        ln: ln,
        last: List[bool](),
        pre: List[byte](),
        pre_at: List[int](),
        vert: vert,
        vleft: vleft,
        corner: corner,
        space: bs(spaces[cl]),
        gap: !o.remove_space,
        cols: cols,
        colors: colors,
        np: name.flags_of(o.quote, o.noprint, o.qmark),
        hyper: o.hyperlink,
        scheme: scheme,
        authority: authority,
        realbase: "",
        pathoffset: 0,
        debug: false,
    }
}

// ---- OSC 8 (`src/render/unix.c:64`) ----

/// tree's URL encoding (`src/render/escape.c:23`): ASCII letters and
/// digits and `/-._~` as they are, every other byte `%XX` (DEVIATION D3:
/// the real byte, not tree's sign-extended one). True when the last byte
/// was a `/`.
pub fn url_encode(mut o: out.Out, s: List[byte], from: int, to: int) -> bool {
    let hex = "0123456789ABCDEF"
    var slash = false
    var i = from
    while i < to {
        let c = s[i] as int
        if c >= 48 && c <= 57 ||
            c >= 65 && c <= 90 ||
            c >= 97 && c <= 122 ||
            c == 47 ||
            c == 45 ||
            c == 46 ||
            c == 95 ||
            c == 126 {
            (mut o.buf).push(s[i])
        } else {
            (mut o.buf).push(37 as byte)
            (mut o.buf).push(hex.bytes()[c / 16])
            (mut o.buf).push(hex.bytes()[c % 16])
        }
        slash = c == 47
        i += 1
    }
    slash
}

fn open_link(mut t: Text, dir: List[byte], dirlen: int, file: List[byte], ffrom: int, fto: int) {
    let off = t.pathoffset
    let sublen = if dirlen > off then dirlen - off else 0
    out.s(mut t.o, "\u{1b}]8;;")
    out.s(mut t.o, t.scheme)
    let au = bs(t.authority)
    let _ = url_encode(mut t.o, au, 0, au.len)
    out.c(mut t.o, 58)
    let rb = bs(t.realbase)
    var slash = url_encode(mut t.o, rb, 0, rb.len)
    if sublen > 0 {
        slash = slash || dir[off] as int == 47
        if !slash {
            out.c(mut t.o, 47)
        }
        if !url_encode(mut t.o, dir, off, off + sublen) {
            out.c(mut t.o, 47)
        }
    } else if !slash {
        out.c(mut t.o, 47)
    }
    let _ = url_encode(mut t.o, file, ffrom, fto)
    out.s(mut t.o, "\u{1b}\\")
}

fn close_link(mut t: Text) {
    out.s(mut t.o, "\u{1b}]8;;\u{1b}\\")
}

// ---- the suffixes (`src/render/unix.c:95`) ----

fn is_exec(mode: int) -> bool {
    mode & 73 != 0
}

/// tree's `-F` suffix for an entry.
fn ftype(o: opts.Opts, kind: int, exe: bool) -> int {
    if kind == 1 {
        return if o.dirsonly then 0 else 47
    }
    if kind == 5 {
        return 61
    }
    if kind == 4 {
        return 124
    }
    if kind == 0 && exe {
        return 42
    }
    0
}

/// The root's `-F` suffix, straight from its mode (`src/render/unix.c:110`).
fn root_ftype(o: opts.Opts, st: ent.Meta) -> int {
    if st.kind == 1 {
        return if o.dirsonly then 0 else 47
    }
    if st.kind == 5 {
        return 61
    }
    if st.kind == 4 {
        return 124
    }
    if st.kind == 3 {
        return 64
    }
    if st.kind == 0 && is_exec(st.mode) {
        return 42
    }
    0
}

fn meta(mut t: Text, o: opts.Opts, st: ent.Meta, ids: ent.Ids, has: bool) {
    if has {
        info.put_fill(mut t.o, o, mut t.cols, st, ids, true)
    }
}

/// An entry's column: the bytes a stat task formatted, or formatted here.
fn entry_meta(mut t: Text, o: opts.Opts, a: ent.Arena, e: ent.Ent) {
    if e.col >= 0 {
        let full: int = 17592186044416
        let mega: int = 1048576
        let tx = a.coltxt[e.col / full]
        var i = e.col / mega % 16777216
        let end = i + e.col % mega
        while i < end {
            (mut t.o.buf).push(tx.bytes()[i])
            i += 1
        }
        return
    }
    meta(mut t, o, e.st, ent.ids(a, e), e.has_st)
}

/// The root line (`src/render/unix.c:225`).
pub fn root(
    mut t: Text,
    o: opts.Opts,
    path: str,
    err: str,
    st: ent.Meta,
    ids: ent.Ids,
    has_st: bool,
) {
    if t.debug {
        return
    }
    let failed = err.len > 0
    let pb = bs(path)
    if t.hyper {
        // per root: the absolute base and the offset past the root
        let rp = fs_realpath(path) else |_| {
            ""
        }
        t.realbase = rp
        t.pathoffset = if rp.len > 0 then pb.len else 0
    }
    meta(mut t, o, st, ids, has_st)
    // tree links any root that exists, one it could not open too
    // (measured; C aspen only an opened one, `src/render/unix.c:239`)
    let linked = t.hyper && (!failed || has_st)
    if linked {
        open_link(mut t, pb, pb.len, pb, 0, 0)
    }
    var colored = false
    if !failed && t.colors.enabled && has_st {
        colored = color.apply(t.colors, mut t.o, st.kind, st.mode, pb, 0, 0, false, false)
    }
    name.put_flags(mut t.o, pb, 0, pb.len, t.utf8, t.np)
    if colored {
        color.end(t.colors, mut t.o)
    }
    if linked {
        close_link(mut t)
    }
    if o.classify {
        var fc = 0
        if has_st {
            fc = root_ftype(o, st)
        } else if !failed && !o.dirsonly {
            fc = 47
        }
        if fc != 0 {
            out.c(mut t.o, fc)
        }
    }
    if failed {
        out.s(mut t.o, "  [")
        out.s(mut t.o, err)
        out.c(mut t.o, 93)
    }
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// The indentation every entry of a directory at `depth` shares: one
/// glyph per ancestor and, unless `--compress` is negative, a space
/// (`draw_indent`, `src/render/unix.c:144`), built once per directory,
/// since only the entry's own connector differs between siblings. The
/// walk calls this before a directory's entries. Depth d's prefix is
/// depth d-1's plus one glyph, so one buffer holds the deepest open
/// level's and `pre_at[d]` is where depth d's ends.
pub fn begin_level(mut t: Text, o: opts.Opts, depth: int) {
    if o.noindent {
        return
    }
    while t.pre_at.len <= depth {
        (mut t.pre_at).push(0)
    }
    if depth <= 1 {
        while t.pre.len > 0 {
            let _ = (mut t.pre).pop() else 0 as byte
        }
        t.pre_at[depth] = 0
        return
    }
    let base = t.pre_at[depth - 1]
    while t.pre.len > base {
        let _ = (mut t.pre).pop() else 0 as byte
    }
    if depth - 1 < t.last.len && t.last[depth - 1] {
        let n = t.space.len
        var k = 0
        while k < n {
            (mut t.pre).push(t.space[k])
            k += 1
        }
    } else {
        let n = t.vert.len
        var k = 0
        while k < n {
            (mut t.pre).push(t.vert[k])
            k += 1
        }
    }
    if t.gap {
        (mut t.pre).push(32 as byte)
    }
    t.pre_at[depth] = t.pre.len
}

fn indent(mut t: Text, depth: int, is_last: bool) {
    var i = 0
    let end = t.pre_at[depth]
    while i < end {
        (mut t.o.buf).push(t.pre[i])
        i += 1
    }
    if is_last {
        let n = t.corner.len
        var k = 0
        while k < n {
            (mut t.o.buf).push(t.corner[k])
            k += 1
        }
    } else {
        let n = t.vleft.len
        var k = 0
        while k < n {
            (mut t.o.buf).push(t.vleft[k])
            k += 1
        }
    }
    if t.gap {
        (mut t.o.buf).push(32 as byte)
    }
    while t.last.len <= depth {
        (mut t.last).push(false)
    }
    t.last[depth] = is_last
}

/// One entry, without its newline (`src/render/unix.c:268`). `lnk` is a
/// symlink's target (any list when `e.lnk` is -1); `path` is the entry's
/// full path (its last part `--condense`'s joined name), printed in
/// place of the name under `-f`, and the hyperlink's target.
pub fn entry(
    mut t: Text,
    o: opts.Opts,
    a: ent.Arena,
    e: ent.Ent,
    lnk: List[byte],
    path: str,
    depth: int,
    is_last: bool,
) {
    if t.debug {
        debug_entry(mut t, e, path)
        return
    }
    if o.metafirst {
        entry_meta(mut t, o, a, e)
        if !o.noindent {
            indent(mut t, depth, is_last)
        }
    } else {
        if !o.noindent {
            indent(mut t, depth, is_last)
        }
        entry_meta(mut t, o, a, e)
    }
    let ci = ent.cname_of(a, e)
    let cn = ci >= 0
    let nlen = if cn then a.cnames[ci].len - 1 else e.nm.len - 1
    var pb = List[byte]()
    var dirlen = 0
    if t.hyper || o.fullpath {
        pb = bs(path)
        dirlen = pb.len - nlen - 1
    }
    if t.hyper {
        if cn {
            open_link(mut t, pb, dirlen, a.cnames[ci], 1, a.cnames[ci].len)
        } else {
            open_link(mut t, pb, dirlen, e.nm, 1, e.nm.len)
        }
    }
    var colored = false
    if t.colors.enabled {
        var kind = if e.has_st then e.st.kind else -1
        var mode = if e.has_st then e.st.mode else 0
        if e.lnk >= 0 && t.colors.linktarget {
            kind = if e.flags & ent.f_orphan() != 0 then -1 else e.ltype
            mode = ent.lmode(a, e)
        }
        let orphan = e.flags & ent.f_orphan() != 0
        if cn {
            colored = color.apply(
                t.colors,
                mut t.o,
                kind,
                mode,
                a.cnames[ci],
                1,
                a.cnames[ci].len,
                orphan,
                false,
            )
        } else {
            colored = color.apply(t.colors, mut t.o, kind, mode, e.nm, 1, e.nm.len, orphan, false)
        }
    }
    if o.fullpath {
        name.put_flags(mut t.o, pb, 0, pb.len, t.utf8, t.np)
    } else if cn {
        name.put_flags(mut t.o, a.cnames[ci], 1, a.cnames[ci].len, t.utf8, t.np)
    } else {
        name.put_flags(mut t.o, e.nm, 1, e.nm.len, t.utf8, t.np)
    }
    if colored {
        color.end(t.colors, mut t.o)
    }
    if t.hyper {
        close_link(mut t)
    }
    if o.classify && e.lnk < 0 {
        let s = ftype(o, e.kind, e.flags & ent.f_exec() != 0)
        if s != 0 {
            out.c(mut t.o, s)
        }
    }
    if e.lnk >= 0 {
        out.s(mut t.o, " -> ")
        if t.hyper {
            open_link(mut t, pb, dirlen, e.nm, 1, e.nm.len)
        }
        var lc = false
        if t.colors.enabled {
            let orphan = e.flags & ent.f_orphan() != 0
            let lk = if orphan then -1 else e.ltype
            lc = color.apply(t.colors, mut t.o, lk, ent.lmode(a, e), lnk, 0, lnk.len, orphan, true)
        }
        name.put_flags(mut t.o, lnk, 0, lnk.len, t.utf8, t.np)
        if lc {
            color.end(t.colors, mut t.o)
        }
        if t.hyper {
            close_link(mut t)
        }
        if o.classify {
            let s = ftype(o, e.ltype, e.flags & ent.f_lexec() != 0)
            if s != 0 {
                out.c(mut t.o, s)
            }
        }
    }
    out.maybe(mut t.o)
}

/// C aspen's discovery hook for its own tests (`--asp-debug-walk`,
/// `src/main.c:33`): a type letter, a tab and the entry's path, nothing
/// else; `tests/golden/walk.sh` compares the set with tree's.
fn debug_entry(mut t: Text, e: ent.Ent, path: str) {
    let c = match e.kind {
        1 => "d",
        0 => "f",
        3 => "l",
        4 => "p",
        5 => "s",
        6 => "c",
        7 => "b",
        _ => "u",
    }
    out.s(mut t.o, c)
    out.c(mut t.o, 9)
    out.s(mut t.o, path)
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// `--info`'s lines after an entry (`src/render/unix.c:188`): each under
/// every level's continuation glyph, the entry's own included, then the
/// line set's comment glyph, a space and the line.
pub fn comment(mut t: Text, desc: List[List[byte]], depth: int) {
    if t.debug {
        return
    }
    let n = desc.len
    var ln = 0
    while ln < n {
        var d = 1
        while d <= depth {
            let last = d < t.last.len && t.last[d]
            if last {
                out.bytes(mut t.o, t.space, 0, t.space.len)
            } else {
                out.bytes(mut t.o, t.vert, 0, t.vert.len)
            }
            if t.gap {
                out.c(mut t.o, 32)
            }
            d += 1
        }
        if n == 1 {
            out.bytes(mut t.o, t.ln.csingle, 0, t.ln.csingle.len)
        } else if ln == 0 {
            out.bytes(mut t.o, t.ln.ctop, 0, t.ln.ctop.len)
        } else if ln < 2 {
            if n == 2 {
                out.bytes(mut t.o, t.ln.cbot, 0, t.ln.cbot.len)
            } else {
                out.bytes(mut t.o, t.ln.cmid, 0, t.ln.cmid.len)
            }
        } else if ln == n - 1 {
            out.bytes(mut t.o, t.ln.cbot, 0, t.ln.cbot.len)
        } else {
            out.bytes(mut t.o, t.ln.cext, 0, t.ln.cext.len)
        }
        out.c(mut t.o, 32)
        out.bytes(mut t.o, desc[ln], 0, desc[ln].len)
        out.c(mut t.o, 10)
        ln += 1
    }
    out.maybe(mut t.o)
}

/// `  [msg]` (`src/render/unix.c:347`).
pub fn error(mut t: Text, msg: str) {
    if t.debug {
        return
    }
    out.s(mut t.o, "  [")
    out.s(mut t.o, msg)
    out.c(mut t.o, 93)
}

/// End the current line.
pub fn newline(mut t: Text) {
    if t.debug {
        return
    }
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// The report (`src/render/unix.c:362`); the caller skips it under
/// `--noreport`.
pub fn report(mut t: Text, o: opts.Opts, dirs: int, files: int, size: int) {
    if t.debug {
        return
    }
    out.c(mut t.o, 10)
    if o.duflag {
        info.put_psize(mut t.o, o.humanflag, o.siflag, size)
        out.s(mut t.o, if o.humanflag || o.siflag then " used in " else " bytes used in ")
    }
    let d = if dirs == 1 then "directory" else "directories"
    if o.dirsonly {
        out.s(mut t.o, "{dirs} {d}\n")
    } else {
        let f = if files == 1 then "file" else "files"
        out.s(mut t.o, "{dirs} {d}, {files} {f}\n")
    }
}

/// `--asp-diff`'s first line, `A -> B` (`src/diff.c:363`).
pub fn diff_head(mut t: Text, a: str, b: str) {
    out.s(mut t.o, a)
    out.s(mut t.o, " -> ")
    out.s(mut t.o, b)
    out.c(mut t.o, 10)
}

/// One `--asp-diff` line (`src/diff.c:302`): the indentation (always with
/// its spaces), the marker (`[+] `, `[-] `, `[~] `, coloured when colour
/// is on; four spaces for an unchanged directory that holds a change),
/// the name in its colour, a link's target.
pub fn diff_line(
    mut t: Text,
    o: opts.Opts,
    status: int,
    a: ent.Arena,
    e: ent.Ent,
    depth: int,
    is_last: bool,
) {
    var i = 1
    while i < depth {
        let last = i < t.last.len && t.last[i]
        if last {
            out.bytes(mut t.o, t.space, 0, t.space.len)
        } else {
            out.bytes(mut t.o, t.vert, 0, t.vert.len)
        }
        out.c(mut t.o, 32)
        i += 1
    }
    if depth > 0 {
        if is_last {
            out.bytes(mut t.o, t.corner, 0, t.corner.len)
        } else {
            out.bytes(mut t.o, t.vleft, 0, t.vleft.len)
        }
        out.c(mut t.o, 32)
    }
    while t.last.len <= depth {
        (mut t.last).push(false)
    }
    t.last[depth] = is_last
    let colour = t.colors.enabled
    // the marker and its colour; an unchanged directory that holds a
    // change gets four spaces
    let code = if status == 0 {
        "\u{1b}[32m"
    } else if status == 1 {
        "\u{1b}[31m"
    } else {
        "\u{1b}[33m"
    }
    let mark = if status == 0 then "[+] " else if status == 1 then "[-] " else "[~] "
    if status == 3 {
        out.s(mut t.o, "    ")
    } else {
        if colour {
            out.s(mut t.o, code)
        }
        out.s(mut t.o, mark)
        if colour {
            out.s(mut t.o, "\u{1b}[0m")
        }
    }
    var colored = false
    if colour && e.has_st {
        colored = color.apply(
            t.colors,
            mut t.o,
            e.st.kind,
            e.st.mode,
            e.nm,
            1,
            e.nm.len,
            e.flags & ent.f_orphan() != 0,
            false,
        )
    }
    name.put_flags(mut t.o, e.nm, 1, e.nm.len, t.utf8, t.np)
    if colored {
        color.end(t.colors, mut t.o)
    }
    if e.lnk >= 0 {
        out.s(mut t.o, " -> ")
        name.put_flags(mut t.o, a.lnks[e.lnk], 0, a.lnks[e.lnk].len, t.utf8, t.np)
    }
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
    let _ = o.noreport
}

/// `--asp-diff`'s count (`src/diff.c:369`).
pub fn diff_report(mut t: Text, added: int, removed: int, modified: int) {
    out.s(mut t.o, "\n{added} added, {removed} removed, {modified} modified\n")
}

/// Flush what is buffered.
pub fn finish(mut t: Text) {
    out.flush(mut t.o)
}
