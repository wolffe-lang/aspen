//! text — the default listing (C aspen `src/render/unix.c`): indentation
//! lines, the metadata column, the name (or `-f`'s full path), `-F`'s
//! suffix, a link's ` -> target`, the error blurbs, the report line.
//! Colour, `--hyperlink`, `--metafirst`, `-i`, `--compress` and `--info`
//! comments are ap01's.

use clock
use ent
use info
use lines
use name
use opts
use out

/// The text renderer's state: its writer, the locale's UTF-8-ness, the
/// line set, which ancestors were last at their depth, and the zone and
/// clock for `-D`.
pub struct Text {
    o: out.Out,
    utf8: bool,
    ln: lines.Lines,
    last: List[bool],
    pre: List[byte],
    pre_at: List[int],
    corner: List[byte],
    vleft: List[byte],
    zone: clock.Zone,
    now: int,
    debug: bool,
}

/// A renderer writing to descriptor `fd`.
pub fn new(fd: int, utf8: bool, take ln: lines.Lines, take zone: clock.Zone, now: int) -> Text {
    let corner = copy ln.corner
    let vleft = copy ln.vleft
    Text {
        o: out.to_fd(fd),
        utf8: utf8,
        ln: ln,
        last: List[bool](),
        pre: List[byte](),
        pre_at: List[int](),
        corner: corner,
        vleft: vleft,
        zone: zone,
        now: now,
        debug: false,
    }
}

fn is_exec(mode: int) -> bool {
    mode & 73 != 0
}

/// tree's `-F` suffix for an entry (`src/render/unix.c:95`).
fn ftype(o: opts.Opts, kind: int, exe: bool) -> int {
    if kind == 1 {
        return if o.dirsonly then 0 else 47
    }
    if kind == 5 {
        return 61
    }
    if kind == 4 {
        return 124
    }
    if kind == 0 && exe {
        return 42
    }
    0
}

/// The root's `-F` suffix, straight from its mode (`src/render/unix.c:110`).
fn root_ftype(o: opts.Opts, st: ent.Meta) -> int {
    if st.kind == 1 {
        return if o.dirsonly then 0 else 47
    }
    if st.kind == 5 {
        return 61
    }
    if st.kind == 4 {
        return 124
    }
    if st.kind == 3 {
        return 64
    }
    if st.kind == 0 && is_exec(st.mode) {
        return 42
    }
    0
}

fn meta(mut t: Text, o: opts.Opts, st: ent.Meta, has: bool) {
    if has {
        info.put_fill(mut t.o, o, t.zone, t.now, st)
    }
}

/// The root line (`src/render/unix.c:225`).
pub fn root(mut t: Text, o: opts.Opts, path: str, err: str, st: ent.Meta, has_st: bool) {
    if t.debug {
        return
    }
    let failed = err.len > 0
    meta(mut t, o, st, has_st)
    name.put_str(mut t.o, path, t.utf8)
    if o.classify {
        var fc = 0
        if has_st {
            fc = root_ftype(o, st)
        } else if !failed && !o.dirsonly {
            fc = 47
        }
        if fc != 0 {
            out.c(mut t.o, fc)
        }
    }
    if failed {
        out.s(mut t.o, "  [")
        out.s(mut t.o, err)
        out.c(mut t.o, 93)
    }
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// The indentation every entry of a directory at `depth` shares: one
/// glyph and a space per ancestor (`src/render/unix.c:144`'s loop), built
/// once per directory, since only the entry's own connector differs
/// between siblings. The walk calls this before a directory's entries.
/// Depth d's prefix is depth d-1's plus one glyph, so one buffer holds
/// the deepest open level's and `pre_at[d]` is where depth d's ends.
pub fn begin_level(mut t: Text, depth: int) {
    while t.pre_at.len <= depth {
        (mut t.pre_at).push(0)
    }
    if depth <= 1 {
        while t.pre.len > 0 {
            let _ = (mut t.pre).pop() else 0 as byte
        }
        t.pre_at[depth] = 0
        return
    }
    let base = t.pre_at[depth - 1]
    while t.pre.len > base {
        let _ = (mut t.pre).pop() else 0 as byte
    }
    if depth - 1 < t.last.len && t.last[depth - 1] {
        (mut t.pre).push(32 as byte)
        (mut t.pre).push(32 as byte)
        (mut t.pre).push(32 as byte)
    } else {
        var k = 0
        let n = t.ln.vert.len
        while k < n {
            (mut t.pre).push(t.ln.vert[k])
            k += 1
        }
    }
    (mut t.pre).push(32 as byte)
    t.pre_at[depth] = t.pre.len
}

fn indent(mut t: Text, depth: int, is_last: bool) {
    var i = 0
    let end = t.pre_at[depth]
    while i < end {
        (mut t.o.buf).push(t.pre[i])
        i += 1
    }
    if is_last {
        let n = t.corner.len
        var k = 0
        while k < n {
            (mut t.o.buf).push(t.corner[k])
            k += 1
        }
    } else {
        let n = t.vleft.len
        var k = 0
        while k < n {
            (mut t.o.buf).push(t.vleft[k])
            k += 1
        }
    }
    (mut t.o.buf).push(32 as byte)
    while t.last.len <= depth {
        (mut t.last).push(false)
    }
    t.last[depth] = is_last
}

/// One entry, without its newline (`src/render/unix.c:268`). `lnk` is a
/// symlink's target (any list when `e.lnk` is -1); `path` is the entry's
/// full path, printed in place of the name under `-f`.
pub fn entry(
    mut t: Text,
    o: opts.Opts,
    e: ent.Ent,
    lnk: List[byte],
    path: str,
    depth: int,
    is_last: bool,
) {
    if t.debug {
        debug_entry(mut t, e, path)
        return
    }
    indent(mut t, depth, is_last)
    meta(mut t, o, e.st, e.has_st)
    if o.fullpath {
        name.put_str(mut t.o, path, t.utf8)
    } else {
        name.put(mut t.o, e.nm, 1, e.nm.len, t.utf8)
    }
    if o.classify && e.lnk < 0 {
        let s = ftype(o, e.kind, e.flags & ent.f_exec() != 0)
        if s != 0 {
            out.c(mut t.o, s)
        }
    }
    if e.lnk >= 0 {
        out.s(mut t.o, " -> ")
        name.put(mut t.o, lnk, 0, lnk.len, t.utf8)
        if o.classify {
            let s = ftype(o, e.ltype, e.flags & ent.f_lexec() != 0)
            if s != 0 {
                out.c(mut t.o, s)
            }
        }
    }
    out.maybe(mut t.o)
}

/// C aspen's discovery hook for its own tests (`--asp-debug-walk`,
/// `src/main.c:33`): a type letter, a tab and the entry's path, nothing
/// else; `tests/golden/walk.sh` compares the set with tree's.
fn debug_entry(mut t: Text, e: ent.Ent, path: str) {
    let c = match e.kind {
        1 => "d",
        0 => "f",
        3 => "l",
        4 => "p",
        5 => "s",
        6 => "c",
        7 => "b",
        _ => "u",
    }
    out.s(mut t.o, c)
    out.c(mut t.o, 9)
    out.s(mut t.o, path)
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// `  [msg]` (`src/render/unix.c:347`).
pub fn error(mut t: Text, msg: str) {
    if t.debug {
        return
    }
    out.s(mut t.o, "  [")
    out.s(mut t.o, msg)
    out.c(mut t.o, 93)
}

/// End the current line.
pub fn newline(mut t: Text) {
    if t.debug {
        return
    }
    out.c(mut t.o, 10)
    out.maybe(mut t.o)
}

/// The report (`src/render/unix.c:362`); the caller skips it under
/// `--noreport`.
pub fn report(mut t: Text, o: opts.Opts, dirs: int, files: int, size: int) {
    if t.debug {
        return
    }
    out.c(mut t.o, 10)
    if o.duflag {
        out.s(mut t.o, info.psize(o.humanflag, size))
        out.s(mut t.o, if o.humanflag then " used in " else " bytes used in ")
    }
    let d = if dirs == 1 then "directory" else "directories"
    if o.dirsonly {
        out.s(mut t.o, "{dirs} {d}\n")
    } else {
        let f = if files == 1 then "file" else "files"
        out.s(mut t.o, "{dirs} {d}, {files} {f}\n")
    }
}

/// Flush what is buffered.
pub fn finish(mut t: Text) {
    out.flush(mut t.o)
}
