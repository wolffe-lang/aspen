//! info — the bracketed metadata column, `[perms size date]` (C aspen
//! `src/render/fileinfo.c`, "faithful to tree's fillinfo/prot/psize/
//! do_date"). v1's columns are `-p`, `-s`/`-h` and `-D`; `--inodes`,
//! `--device`, `-u`, `-g`, `--si` and `--timefmt` are ap01's.

use clock
use ent
use opts

/// `ls -l`'s type-and-permission string (`src/render/fileinfo.c:13`).
/// `kind` is the entry's type, `mode` its 0o7777 bits.
pub fn prot(kind: int, mode: int) -> str {
    let t = match kind {
        0 => "-",
        1 => "d",
        3 => "l",
        6 => "c",
        7 => "b",
        5 => "s",
        4 => "p",
        _ => "?",
    }
    var p = List[str]()
    let chars = ["r", "w", "x", "r", "w", "x", "r", "w", "x"]
    var bit = 256
    var i = 0
    while i < 9 {
        (mut p).push(if mode / bit % 2 == 1 then chars[i] else "-")
        bit = bit / 2
        i += 1
    }
    if mode / 2048 % 2 == 1 {
        p[2] = if p[2] == "-" then "S" else "s"
    }
    if mode / 1024 % 2 == 1 {
        p[5] = if p[5] == "-" then "S" else "s"
    }
    if mode / 512 % 2 == 1 {
        p[8] = if p[8] == "-" then "T" else "t"
    }
    var out = t
    for x in p {
        out += x
    }
    out
}

fn pad(s: str, w: int) -> str {
    var t = ""
    var k = w - s.len
    while k > 0 {
        t += " "
        k -= 1
    }
    t + s
}

/// `q` rounded half to even after dividing by `d` (both non-negative):
/// what `printf`'s `%.Nf` gives for a quotient that is exact in binary.
fn div_even(q: int, d: int) -> int {
    var n = q / d
    let r = q % d
    if r * 2 > d || r * 2 == d && n % 2 == 1 {
        n += 1
    }
    n
}

/// tree's `psize` (`src/render/fileinfo.c:31`), with its leading space:
/// `" %11lld"`, or with `-h` `" %4d"` below 1 KiB and `" %3.1f%c"` /
/// `" %3.0f%c"` above. Each `-h` quotient is `size / 1024` with `size`
/// below 2^20, exact in binary, so `%f`'s round-half-even is integer
/// arithmetic here.
pub fn psize(human: bool, size0: int) -> str {
    if !human {
        return " " + pad("{size0}", 11)
    }
    let units = ["B", "K", "M", "G", "T", "P", "E", "Z", "Y"]
    var size = size0
    var idx = if size < 1024 then 0 else 1
    while size >= 1048576 {
        idx += 1
        size = size / 1024
    }
    if idx == 0 {
        return " " + pad("{size}", 4)
    }
    if (size + 52) / 1024 >= 10 {
        let n = div_even(size, 1024)
        return " " + pad("{n}", 3) + units[idx]
    }
    let n = div_even(size * 10, 1024)
    " " + pad("{n / 10}.{n % 10}", 3) + units[idx]
}

fn two(n: int) -> str {
    if n < 10 then "0{n}" else "{n}"
}

/// tree's date (`src/render/fileinfo.c:52`): `"%b %e  %Y"` for a time in
/// the future or more than six months of 31 days ago, else `"%b %e %R"`,
/// in the C locale's month names (aspen sets only LC_CTYPE and
/// LC_COLLATE, `src/main.c:89`).
pub fn date(z: clock.Zone, now: int, t: int) -> str {
    let months = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
    ]
    let (y, m, d, hh, mm) = clock.fields(z, t)
    let day = if d < 10 then " {d}" else "{d}"
    let six = 6 * 31 * 24 * 60 * 60
    if t > now || t + six < now {
        return "{months[m - 1]} {day}  {y}"
    }
    "{months[m - 1]} {day} {two(hh)}:{two(mm)}"
}

/// The column for `st` (`src/render/fileinfo.c:79`): `[...]`, or ""
/// when no v1 column is on.
pub fn fill(o: opts.Opts, z: clock.Zone, now: int, st: ent.Meta) -> str {
    var t = ""
    if o.permflag {
        t += " " + prot(st.kind, st.mode)
    }
    if o.sizeflag {
        t += psize(o.humanflag, st.size)
    }
    if o.dateflag {
        t += " " + date(z, now, st.mtime)
    }
    if t.len == 0 {
        return ""
    }
    "[" + t[1..] + "]"
}
