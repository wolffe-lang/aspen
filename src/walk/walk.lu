//! walk — the traversal (C aspen `src/traverse.c`, `src/sort.c`,
//! `src/render.c`): read one directory, filter it, stat what a flag
//! needs, sort it, and either stream it to a line renderer (the default)
//! or build the whole tree first (`--du`, `--prune`, `--matchdirs`,
//! `--filelimit`, `--condense`, and every `-J`/`-X` run) and emit it
//! after; `--fromfile` builds its tree from the input instead.
//!
//! The renderers are C aspen's two kinds (`src/render.h`): the line
//! renderers, text and HTML, which the walk calls as it goes, and the
//! nested ones, JSON and XML, which it hands each root's built tree.
//! The C dispatches through function tables; here `fmt` picks the arm.
//!
//! The C walks fd-relative (`openat`, `getdents64`) and stats only when
//! `d_type` is not enough (`src/traverse.c:188`); wolf-std's directory
//! listing is path-based but answers `d_type` too (`fs_read_dir_entries`),
//! so aspen also stats only for a flag that needs metadata, a symlink,
//! or an entry whose type the host did not give.

use clock
use color
use ent
use fromfile
use gitignore
use glob
use html
use info
use infofile
use json
use lines
use opts
use out
use std.os
use text
use vers
use xml

/// What a walk is built from, kept so `-R` can build another for a
/// subtree's `00Tree.html` (`src/render/unix.c:396`).
pub struct Env {
    utf8: bool,
    macos: bool,
    zone: clock.Zone,
    now: int,
    colors: color.Colors,
    debug: bool,
}

/// The walk's state: the format, the renderers (one is used), the built
/// tree's arena, the totals and the error count, the per-root state of
/// the filters (`-l`'s seen set, `-x`'s device, the gitignore and info
/// stacks), and the stat pool's plan. The options travel beside it,
/// read-only.
pub struct Walk {
    env: Env,
    fmt: int,
    t: text.Text,
    h: html.Html,
    j: json.Json,
    x: xml.Xml,
    a: ent.Arena,
    none: List[byte],
    dirs: int,
    files: int,
    size: int,
    errors: int,
    seen: Map[str, bool],
    root_dev: int,
    igs: List[gitignore.Ignore],
    infs: List[infofile.Info],
    info_top: bool,
    want_pool: bool,
    workers: int,
    pool: int,
}

/// A walk writing format `o.format` (the debug hook's own listing under
/// `--asp-debug-walk`) to descriptor `fd`.
pub fn make(o: opts.Opts, fd: int, e: Env) -> Walk {
    let ln = lines.pick(o, e.utf8)
    let (has_cs, cs) = lines.name(o, e.utf8)
    let z: int = 0
    let (want_pool, workers) = pool_plan(o)
    var c1 = info.cols(take copy e.zone, e.now, e.macos)
    var c2 = info.cols(take copy e.zone, e.now, e.macos)
    var c3 = info.cols(take copy e.zone, e.now, e.macos)
    var c4 = info.cols(take copy e.zone, e.now, e.macos)
    var t = text.new(fd, o, e.utf8, take copy ln, take c1, take copy e.colors)
    t.debug = e.debug
    let h = html.new(fd, o, e.utf8, take copy ln, has_cs, cs, take c2)
    let j = json.new(fd, take c3)
    let x = xml.new(fd, has_cs, cs, take c4)
    Walk {
        env: copy e,
        fmt: if e.debug then opts.out_unix() else o.format,
        t: t,
        h: h,
        j: j,
        x: x,
        a: ent.arena(),
        none: List[byte](),
        dirs: z,
        files: z,
        size: z,
        errors: z,
        seen: Map[str, bool](),
        root_dev: z,
        igs: List[gitignore.Ignore](),
        infs: List[infofile.Info](),
        info_top: false,
        want_pool: want_pool,
        workers: workers,
        pool: z,
    }
}

fn is_tree_fmt(w: Walk) -> bool {
    w.fmt == opts.out_json() || w.fmt == opts.out_xml()
}

fn is_exec(mode: int) -> bool {
    mode & 73 != 0
}

// ---- what to stat (`src/traverse.c:203`) ----

/// Any flag that needs the bracketed metadata column.
fn meta_wanted(o: opts.Opts) -> bool {
    o.sizeflag ||
        o.permflag ||
        o.userflag ||
        o.groupflag ||
        o.dateflag ||
        o.inodeflag ||
        o.devflag ||
        o.duflag
}

fn sort_needs_stat(o: opts.Opts) -> bool {
    o.sort == opts.sort_size() || o.sort == opts.sort_mtime() || o.sort == opts.sort_ctime()
}

/// Does every entry need its full metadata (`want_entry_stat`)?
fn want_st(o: opts.Opts) -> bool {
    meta_wanted(o) || sort_needs_stat(o) || o.colorize
}

/// Does an entry's owners or identity get read (`-u`, `-g`, `--inodes`,
/// `--device`, `-x`, `-l`)?
fn need_ids(o: opts.Opts) -> bool {
    o.userflag || o.groupflag || o.inodeflag || o.devflag || o.xdev || o.follow
}

/// The type-only needs of a non-link (`nonlink_needs_stat`): `-F`'s exec
/// bit, `-x`'s device, `-l`'s identity.
fn nonlink_needs(t: int, o: opts.Opts) -> bool {
    o.classify && t == ent.reg() || o.xdev && t == ent.dir() || o.follow && t == ent.dir()
}

fn root_needs_stat(o: opts.Opts) -> bool {
    meta_wanted(o) || o.colorize || o.classify
}

/// The modes that build the whole tree before emitting (`needfulltree`).
fn full_tree(o: opts.Opts) -> bool {
    o.duflag || o.prune || o.matchdirs || o.filelimit > 0 || o.condense
}

/// The stat pool's plan (`asp_statprov_create`, `src/traverse.c:345`):
/// wanted when some entry is stat'ed, `--threads 1` and `ASP_IO=serial`
/// keep it serial, `--fromfile` stats nothing; the worker count is
/// `--threads N`, else the CPUs wolf-std counts, at most 16.
fn pool_plan(o: opts.Opts) -> (bool, int) {
    let stat_heavy = want_st(o) || o.classify || o.xdev || o.follow
    let io = env_get("ASP_IO") else ""
    let serial = o.threads == 1 || io == "serial"
    if !stat_heavy || serial || o.fromfile || o.fromtabfile {
        return (false, 1)
    }
    if io == "uring" {
        // C aspen's own notice where io_uring is unavailable; wolf has no
        // io_uring surface (a ruling asked, notes/ap01-the-second-light.md)
        eprint_raw(
            "aspen: ASP_IO=uring requested but io_uring is unavailable; using the thread pool.\n",
        )
    }
    var workers = o.threads
    if workers <= 0 {
        workers = os.cpus() else 1
        if workers < 1 {
            workers = 1
        }
        if workers > 16 {
            workers = 16
        }
    }
    (workers > 1, workers)
}

// ---- paths ----

fn name_str(nm: List[byte]) -> str {
    // a name that is not UTF-8 cannot be a wolf path (wolf-lang#687); the
    // replacement makes every open or stat of it fail, by construction
    str_from_utf8(nm[1..]) else "\u{fffd}/"
}

fn join(path: str, nm: List[byte]) -> str {
    "{path}/{name_str(nm)}"
}

/// The name an entry shows: `--condense`'s joined chain, else its own,
/// as a row (byte 0 a placeholder, the name after it).
fn shown(a: ent.Arena, e: ent.Ent) -> List[byte] {
    let ci = ent.cname_of(a, e)
    if ci >= 0 {
        return copy a.cnames[ci]
    }
    copy e.nm
}

fn join_shown(path: str, a: ent.Arena, e: ent.Ent) -> str {
    let ci = ent.cname_of(a, e)
    if ci >= 0 {
        return "{path}/{name_str(a.cnames[ci])}"
    }
    join(path, e.nm)
}

/// The entry's path as bytes, for the matchers: the directory's path, a
/// `/`, the name.
fn path_bytes(path: str, nm: List[byte]) -> List[byte] {
    var b = List[byte]()
    for x in path.bytes() {
        (mut b).push(x)
    }
    (mut b).push(47 as byte)
    var i = 1
    while i < nm.len {
        (mut b).push(nm[i])
        i += 1
    }
    b
}

fn ident(ino: int, dev: int) -> str {
    "{dev}:{ino}"
}

fn row_of(name: List[byte]) -> List[byte] {
    var r = List[byte]()
    (mut r).push(0 as byte)
    for x in name {
        (mut r).push(x)
    }
    r
}

// ---- one level ----

/// One directory's entries, filtered and stat'ed (`src/traverse.c:434`).
/// `rows` is what `fs_read_dir_entries(path)` answered; they are taken
/// from its end, which reverses the host's order before the sort decides
/// the real one, except under `-U`, where the host's order is the order
/// shown and the rows are put back in it first.
fn read_level(
    mut w: Walk,
    o: opts.Opts,
    path: str,
    take rows: List[List[byte]],
    take into: List[ent.Ent],
    suppress: bool,
) -> List[ent.Ent] {
    let want = want_st(o)
    let nids = need_ids(o)
    let pats = o.patterns.len > 0
    let ipats = o.ipatterns.len > 0
    let gits = o.gitignore && w.igs.len > 0
    let infos = o.showinfo && w.infs.len > 0
    let is_html = w.fmt == opts.out_html()
    var rs = rows
    if o.sort == opts.sort_none() {
        var rev = List[List[byte]]()
        while rs.len > 0 {
            let r = (mut rs).pop() else List[byte]()
            (mut rev).push(r)
        }
        rs = rev
    }
    var ev = into
    var pend = List[int]()
    while rs.len > 0 {
        let r = (mut rs).pop() else List[byte]()
        if r.len < 2 {
            continue
        }
        if !o.all && r[1] as int == 46 {
            continue
        }
        if is_html && r.len == 12 && r[1] as int == 48 && name_str(r) == "00Tree.html" {
            // -H hides the files -R writes (`src/traverse.c:447`)
            continue
        }
        var t = r[0] as int
        let lp = if t == ent.unknown() || t == ent.lnk() then join(path, r) else ""
        var e = ent.new_ent(take r, t)
        // the type the host did not give: lstat it (filtering needs it)
        var have = false
        if t == ent.unknown() {
            let wds = fs_lstat(lp) else |_| {
                w.errors += 1
                continue
            }
            have = true
            t = wds[0]
            e.kind = t
            if nids {
                let xi = ent.ensure_x(mut w.a, mut e)
                w.a.xs[xi].ids = ent.ids_of(wds)
                w.a.xs[xi].has_ids = true
            }
            if t == ent.reg() && is_exec(wds[4]) {
                e.flags = e.flags | ent.f_exec()
            }
            if want {
                e.st = ent.meta_of(wds)
                e.has_st = true
            }
        }
        let deferred = !have && t != ent.lnk() && (want || nonlink_needs(t, o))
        if t == ent.lnk() {
            if want {
                // the link's own lstat feeds the columns (D4)
                let lw = fs_lstat(lp) else |_| {
                    w.errors += 1
                    continue
                }
                e.st = ent.meta_of(lw)
                e.has_st = true
                if nids {
                    let xi = ent.ensure_x(mut w.a, mut e)
                    w.a.xs[xi].ids = ent.ids_of(lw)
                    w.a.xs[xi].has_ids = true
                }
            }
            let target = fs_read_link(lp) else |_| {
                var m = List[byte]()
                for x in "[Error reading symbolic link information]".bytes() {
                    (mut m).push(x)
                }
                m
            }
            e.lnk = w.a.lnks.len
            (mut w.a.lnks).push(target)
            (mut w.a.lstats).push(ent.Lst { mode: 0, ino: 0, dev: 0 })
            var orphan = false
            let tw = fs_stat(lp) else |_| {
                orphan = true
                List[int]()
            }
            if orphan {
                e.flags = e.flags | ent.f_orphan()
            } else {
                e.ltype = tw[0]
                w.a.lstats[e.lnk] = ent.Lst { mode: tw[4], ino: tw[10], dev: tw[9] }
                if e.ltype == ent.reg() && is_exec(tw[4]) {
                    e.flags = e.flags | ent.f_lexec()
                }
            }
        }
        let isdir = t == ent.dir() || t == ent.lnk() && e.ltype == ent.dir()
        if gits {
            let fb = path_bytes(path, e.nm)
            if gitignore.filtered(w.igs, fb, fb.len - (e.nm.len - 1), isdir, o.ignorecase) {
                continue
            }
        }
        // -P applies to non-directories (a symlink to one too under -l);
        // -I to everything; both match the name, the path, a path suffix
        if pats &&
            !suppress &&
            t != ent.dir() &&
            !(o.follow && t == ent.lnk() && e.ltype == ent.dir()) {
            let fb = path_bytes(path, e.nm)
            if !glob.full(o.patterns, fb, fb.len - (e.nm.len - 1), isdir, o.ignorecase) {
                continue
            }
        }
        if ipats {
            let fb = path_bytes(path, e.nm)
            if glob.full(o.ipatterns, fb, fb.len - (e.nm.len - 1), isdir, o.ignorecase) {
                continue
            }
        }
        if o.dirsonly && !isdir {
            continue
        }
        if infos {
            let fb = path_bytes(path, e.nm)
            let (fk, ci) = infofile.check(
                w.infs,
                fb,
                fb.len - (e.nm.len - 1),
                w.info_top,
                isdir,
                o.ignorecase,
            )
            if fk >= 0 {
                let xi = ent.ensure_x(mut w.a, mut e)
                w.a.xs[xi].info = w.a.infos.len
                (mut w.a.infos).push(copy w.infs[fk].comments[ci].desc)
            }
        }
        if deferred {
            // stat'ed after the filters, as a batch (`src/traverse.c:583`)
            (mut pend).push(ev.len)
        }
        (mut ev).push(e)
    }
    if pend.len > 0 {
        stat_batch(mut w, o, mut ev, pend, path, want)
    }
    ev
}

/// The words a deferred stat answers, by what the flags read: the mode
/// (`-p`, `-F`, colour), the size, the times, the owners, the identity
/// (`--inodes`, `--device`, `-x`, `-l`).
struct Need {
    mode: bool,
    size: bool,
    mtime: bool,
    ctime: bool,
    ids: bool,
    ident: bool,
}

fn need_of(o: opts.Opts) -> Need {
    Need {
        mode: o.permflag || o.classify || o.colorize,
        size: o.sizeflag || o.duflag || o.sort == opts.sort_size(),
        mtime: o.dateflag && !o.ctimeflag || o.sort == opts.sort_mtime(),
        ctime: o.dateflag && o.ctimeflag || o.sort == opts.sort_ctime(),
        ids: o.userflag || o.groupflag,
        ident: o.inodeflag || o.devflag || o.xdev || o.follow,
    }
}

/// What a stat task answers per name (`stat_batch`): the words, the
/// column, or (`lean`) the column alone.
struct Words {
    mode: bool,
    size: bool,
    mtime: bool,
    ctime: bool,
    ids: bool,
    ident: bool,
    precol: bool,
    lean: bool,
}

/// One chunk of a level's stats: `names` (each a length byte and its
/// bytes) under `dir`, answered as one text, a line per name.
fn stat_chunk(names: List[byte], dir: str, opt: opts.Opts, mut cs: info.Cols, f: Words) -> str {
    var b = List[byte]()
    var col = out.to_fd(-1)
    // one path buffer, the directory and a slash kept, each name put
    // after them in turn: a path costs one `str`, not three copies
    var pb = List[byte]()
    for x in dir.bytes() {
        (mut pb).push(x)
    }
    (mut pb).push(47 as byte)
    let base = pb.len
    var i = 0
    let nn = names.len
    while i < nn {
        let ln = names[i] as int
        while pb.len > base {
            let _ = (mut pb).pop() else 0 as byte
        }
        var k = i + 1
        let end = i + 1 + ln
        while k < end {
            (mut pb).push(names[k])
            k += 1
        }
        i = end
        // the path and the stat's twenty words die with each name: only
        // their numbers leave the region (wolf frees nothing a caller can
        // still see before the program ends, so this halves `-s`'s peak)
        var ok = true
        var kind = 0
        var mode = 0
        var size: int = 0
        var mt: int = 0
        var ct: int = 0
        var uid: int = 0
        var gid: int = 0
        var ino: int = 0
        var dev: int = 0
        region one {
            let p = str_from_utf8(pb) else "\u{fffd}/"
            // PLANT: eight stats of each name, seven thrown away
            var extra = 0
            while extra < 7 {
                let _ = fs_lstat(p) else List[int]()
                extra += 1
            }
            let sw = fs_lstat(p) else |_| {
                ok = false
                List[int]()
            }
            if ok {
                kind = sw[0]
                size = sw[1]
                mode = sw[4]
                uid = sw[6]
                gid = sw[7]
                dev = sw[9]
                ino = sw[10]
                mt = sw[14]
                ct = sw[16]
            }
        }
        let m = ent.Meta { kind: kind, mode: mode, size: size, mtime: mt, ctime: ct }
        let d = ent.Ids { uid: uid, gid: gid, ino: ino, dev: dev }
        if ok && f.lean {
            while col.buf.len > 0 {
                let _ = (mut col.buf).pop() else 0 as byte
            }
            info.put_fill(mut col, opt, mut cs, m, d, true)
            put_word(mut b, col.buf.len)
            for x in col.buf {
                (mut b).push(x)
            }
        } else if ok {
            put_word(mut b, m.kind)
            if f.mode {
                put_word(mut b, m.mode)
            }
            if f.size {
                put_word(mut b, m.size)
            }
            if f.mtime {
                put_word(mut b, m.mtime)
            }
            if f.ctime {
                put_word(mut b, m.ctime)
            }
            if f.ids {
                put_word(mut b, d.uid)
                put_word(mut b, d.gid)
            }
            if f.ident {
                put_word(mut b, d.ino)
                put_word(mut b, d.dev)
            }
            if f.precol {
                while col.buf.len > 0 {
                    let _ = (mut col.buf).pop() else 0 as byte
                }
                info.put_fill(mut col, opt, mut cs, m, d, true)
                put_word(mut b, col.buf.len)
                for x in col.buf {
                    (mut b).push(x)
                }
            }
        } else {
            (mut b).push(120 as byte)
        }
        (mut b).push(10 as byte)
    }
    str_from_utf8(b) else ""
}

/// The deferred stats of one level (`src/traverse.c:393`): serial below
/// C aspen's threshold of 384 (`ASP_STAT_PAR_MIN`); above it on the
/// pool, sized at the first batch that crosses the threshold to one task
/// per 256 entries (`ASP_STAT_PER_WORKER`) and at most the planned
/// workers, then kept (`src/traverse.c:410`). Output is decided by name
/// before any stat (the order is the sort's), so the split changes only
/// the time. An entry whose stat fails is dropped, in order, and counted
/// an error.
///
/// On the pool each task builds its paths from the directory and its
/// chunk's names, and in the text format (no `--du`, which changes the
/// sizes after) it formats each entry's bracket column too, the bytes
/// the renderer prints: the main thread keeps the chunk's answer and the
/// column's place in it (the `-s` ratchet, notes/ap01-the-second-light.md).
fn stat_batch(
    mut w: Walk,
    o: opts.Opts,
    mut ev: List[ent.Ent],
    pend: List[int],
    path: str,
    want: bool,
) {
    let n = pend.len
    let nids = need_ids(o)
    if w.want_pool && n >= 384 {
        w.want_pool = false
        var k = (n + 255) / 256
        if k > w.workers {
            k = w.workers
        }
        if k < 1 {
            k = 1
        }
        w.pool = k
        var tr = true
        let _ = env_get("ASP_TRACE_POOL") else |_| {
            tr = false
            ""
        }
        if tr && k > 1 {
            eprint_raw("aspen: stat-pool spawned {k} workers (batch={n})\n")
        }
    }
    var failed = false
    let workers = if n >= 384 && w.pool > 1 then w.pool else 1
    if workers < 2 {
        var k = 0
        while k < n {
            // the path and the twenty words die with each entry (as in
            // `stat_chunk`); their numbers leave the region
            var ok = true
            var q = [0, 0, 0, 0, 0, 0, 0, 0, 0]
            region one {
                let sw = fs_lstat(join(path, ev[pend[k]].nm)) else |_| {
                    ok = false
                    List[int]()
                }
                if ok {
                    q[0] = sw[0]
                    q[1] = sw[1]
                    q[2] = sw[4]
                    q[3] = sw[6]
                    q[4] = sw[7]
                    q[5] = sw[9]
                    q[6] = sw[10]
                    q[7] = sw[14]
                    q[8] = sw[16]
                }
            }
            if ok {
                let m = ent.Meta { kind: q[0], mode: q[2], size: q[1], mtime: q[7], ctime: q[8] }
                let d = ent.Ids { uid: q[3], gid: q[4], ino: q[6], dev: q[5] }
                apply(mut ev, mut w.a, pend[k], m, d, nids, want)
            } else {
                ev[pend[k]].flags = ev[pend[k]].flags | ent.f_stat_failed()
                failed = true
            }
            k += 1
        }
    } else {
        // each task answers with one message: its chunk number and a line
        // per name (the words below, then the column's length and bytes
        // when `precol`, or "x" for a failure); a channel carries no list
        let precol = want && w.fmt == opts.out_unix() && !o.duflag && !w.env.debug && info.any(o)
        // lean: the column is all the main thread needs (no -F, no colour,
        // no sort by a stat'ed key, no -x or -l): each line is the
        // column's length and bytes, and the entry keeps only their place
        let lean = precol &&
            !o.classify &&
            !o.colorize &&
            !sort_needs_stat(o) &&
            !o.xdev &&
            !o.follow
        let nd = need_of(o)
        let w_mode = nd.mode && !precol || o.classify || o.colorize
        let w_size = nd.size && !precol || o.sort == opts.sort_size()
        let w_mtime = nd.mtime && !precol || o.sort == opts.sort_mtime()
        let w_ctime = nd.ctime && !precol || o.sort == opts.sort_ctime()
        let w_ids = nd.ids && !precol
        let w_ident = nd.ident && !precol || o.xdev || o.follow
        let fl = Words {
            mode: w_mode,
            size: w_size,
            mtime: w_mtime,
            ctime: w_ctime,
            ids: w_ids,
            ident: w_ident,
            precol: precol,
            lean: lean,
        }
        let ch = channel[(int, str)](workers)
        scope s {
            // the chunks' names, each a length byte and its bytes (a name
            // is at most 255 bytes); the main thread stats chunk 0 itself,
            // as C aspen's submitting thread is one of its pool's lanes
            // (`src/pool.c:152`)
            var mine = List[byte]()
            var c = 0
            while c < workers {
                let lo = c * n / workers
                let hi = (c + 1) * n / workers
                var names = List[byte]()
                var k = lo
                while k < hi {
                    let ek = pend[k]
                    let ln = ev[ek].nm.len - 1
                    (mut names).push(ln as byte)
                    var x = 1
                    while x <= ln {
                        (mut names).push(ev[ek].nm[x])
                        x += 1
                    }
                    k += 1
                }
                if c == 0 {
                    mine = names
                } else {
                    let id = c
                    let dir = path
                    let opt = copy o
                    let cols0 = copy w.t.cols
                    let f0 = copy fl
                    s.spawn(fn() {
                        var cs = copy cols0
                        let text = stat_chunk(names, dir, opt, mut cs, f0)
                        ch.send((id, text)) else |_| {}
                    })
                }
                c += 1
            }
            var cs = copy w.t.cols
            let text0 = stat_chunk(mine, path, o, mut cs, fl)
            ch.send((0, text0)) else |_| {}
            var got = 0
            while got < workers {
                var live = true
                let (id, text) = ch.recv() else |_| {
                    live = false
                    (0, "")
                }
                if !live {
                    break
                }
                let tix = w.a.coltxt.len
                if precol {
                    (mut w.a.coltxt).push(text)
                }
                let lo = id * n / workers
                var k = lo
                var i = 0
                let len = text.len
                while i < len {
                    if text.bytes()[i] as int == 120 {
                        ev[pend[k]].flags = ev[pend[k]].flags | ent.f_stat_failed()
                        failed = true
                        i += 2
                    } else if lean {
                        let (cl, j) = word(text, i)
                        ev[pend[k]].col = pack_col(tix, j, cl)
                        i = j + cl + 1
                    } else {
                        var m = ent.no_meta()
                        var ids = ent.no_ids()
                        let (v0, j0) = word(text, i)
                        m.kind = v0
                        i = j0
                        if w_mode {
                            let (v, j) = word(text, i)
                            m.mode = v
                            i = j
                        }
                        if w_size {
                            let (v, j) = word(text, i)
                            m.size = v
                            i = j
                        }
                        if w_mtime {
                            let (v, j) = word(text, i)
                            m.mtime = v
                            i = j
                        }
                        if w_ctime {
                            let (v, j) = word(text, i)
                            m.ctime = v
                            i = j
                        }
                        if w_ids {
                            let (v1, j1) = word(text, i)
                            let (v2, j2) = word(text, j1)
                            ids.uid = v1
                            ids.gid = v2
                            i = j2
                        }
                        if w_ident {
                            let (v1, j1) = word(text, i)
                            let (v2, j2) = word(text, j1)
                            ids.ino = v1
                            ids.dev = v2
                            i = j2
                        }
                        let e = pend[k]
                        if precol {
                            let (cl, j) = word(text, i)
                            ev[e].col = pack_col(tix, j, cl)
                            i = j + cl
                        }
                        i += 1
                        apply(mut ev, mut w.a, e, m, ids, nids, want)
                    }
                    k += 1
                }
                got += 1
            }
        }
    }
    if failed {
        // drop the failed ones, in order (tree drops an entry whose stat
        // fails, `src/traverse.c:586`)
        var kept = List[ent.Ent]()
        var i = 0
        while i < ev.len {
            if ev[i].flags & ent.f_stat_failed() != 0 {
                w.errors += 1
            } else {
                (mut kept).push(copy ev[i])
            }
            i += 1
        }
        ev = kept
    }
}

/// A column's place in a chunk's text, as one `int` (`Ent.col`).
fn pack_col(chunk: int, at: int, len: int) -> int {
    let full: int = 17592186044416
    let mega: int = 1048576
    chunk * full + at * mega + len
}

/// The number at `text[i..]` and the index after the space that ends it.
fn word(text: str, i0: int) -> (int, int) {
    var i = i0
    var neg = false
    if text.bytes()[i] as int == 45 {
        neg = true
        i += 1
    }
    var v: int = 0
    let len = text.len
    while i < len {
        let c = text.bytes()[i] as int
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        i += 1
    }
    (if neg then -v else v, i + 1)
}

fn put_word(mut b: List[byte], v: int) {
    var n = v
    if n < 0 {
        (mut b).push(45 as byte)
        n = -n
    }
    var p: int = 1
    while p <= n / 10 {
        p = p * 10
    }
    while p > 0 {
        (mut b).push((48 + n / p % 10) as byte)
        p = p / 10
    }
    (mut b).push(32 as byte)
}

/// One stat's answer into entry `k` (`stat_one`, `src/traverse.c:313`):
/// the identity, the exec bit for `-F`, and the metadata when a flag
/// wants it.
fn apply(
    mut ev: List[ent.Ent],
    mut a: ent.Arena,
    k: int,
    m: ent.Meta,
    ids: ent.Ids,
    nids: bool,
    want: bool,
) {
    if nids {
        let xi = ent.ensure_x(mut a, mut ev[k])
        a.xs[xi].ids = copy ids
        a.xs[xi].has_ids = true
    }
    if ev[k].kind == ent.reg() && is_exec(m.mode) {
        ev[k].flags = ev[k].flags | ent.f_exec()
    }
    if want {
        ev[k].st = copy m
        ev[k].has_st = true
    }
}

// ---- the sort (`src/sort.c`) ----

/// Byte order of two names (`strcmp`, `src/sort.c:56`: the collation of
/// C and C.UTF-8; `src/locale` says what a dictionary locale does
/// instead).
fn namecmp(a: List[byte], b: List[byte]) -> int {
    let na = a.len
    let nb = b.len
    var i = 1
    while i < na && i < nb {
        let x = a[i] as int
        let y = b[i] as int
        if x != y {
            return if x < y then -1 else 1
        }
        i += 1
    }
    if na == nb {
        return 0
    }
    if na < nb then -1 else 1
}

fn time_of(e: ent.Ent, ctime: bool) -> int {
    if !e.has_st {
        return 0
    }
    if ctime then e.st.ctime else e.st.mtime
}

/// tree's base comparator (`src/sort.c:75`), reversed by `-r`.
fn basecmp(o: opts.Opts, x: ent.Ent, y: ent.Ent) -> int {
    var v = 0
    if o.sort == opts.sort_version() {
        v = vers.cmp(x.nm, y.nm)
    } else if o.sort == opts.sort_size() {
        let sa = if x.has_st then x.st.size else 0
        let sb = if y.has_st then y.st.size else 0
        if sa == sb {
            v = namecmp(x.nm, y.nm)
        } else {
            v = if sa < sb then 1 else -1
        }
    } else if o.sort == opts.sort_mtime() || o.sort == opts.sort_ctime() {
        let c = o.sort == opts.sort_ctime()
        let ta = time_of(x, c)
        let tb = time_of(y, c)
        if ta == tb {
            v = namecmp(x.nm, y.nm)
        } else {
            v = if ta < tb then -1 else 1
        }
    } else {
        v = namecmp(x.nm, y.nm)
    }
    if o.reverse then -v else v
}

/// tree's comparator (`src/sort.c:101`): `--dirsfirst`/`--filesfirst`,
/// then the base sort.
fn cmp(o: opts.Opts, ev: List[ent.Ent], a: int, b: int) -> int {
    if o.dirsfirst || o.filesfirst {
        let da = ent.dir_like(ev[a])
        let db = ent.dir_like(ev[b])
        if da != db {
            if o.dirsfirst {
                return if da then -1 else 1
            }
            return if da then 1 else -1
        }
    }
    basecmp(o, ev[a], ev[b])
}

/// The display order of `ev` (`asp_sort`, `src/sort.c:219`): none under
/// `-U`; else a bottom-up merge sort of indices, O(n log n). The plain
/// name order (no other key, no `--dirsfirst`/`--filesfirst`) compares a
/// packed key first: a name's first seven bytes as one `int` (no name
/// holds a NUL, so a byte past the end is 0 and sorts first, as `strcmp`
/// has it), the bytes after them only when two keys tie; `-r` reverses
/// that order whole, exact for unique names. C aspen sorts the same order
/// with an MSD radix (`src/sort.c:163`); every other order goes through
/// `cmp`, tree's comparator, total on unique names.
fn order(o: opts.Opts, ev: List[ent.Ent]) -> List[int] {
    let n = ev.len
    var a = List[int]()
    var tmp = List[int]()
    var i = 0
    while i < n {
        (mut a).push(i)
        (mut tmp).push(0)
        i += 1
    }
    if n < 2 || o.sort == opts.sort_none() {
        return a
    }
    let plain = o.sort == opts.sort_name() && !o.dirsfirst && !o.filesfirst
    var keys = List[int]()
    if plain {
        i = 0
        while i < n {
            (mut keys).push(pack(ev[i].nm))
            i += 1
        }
    }
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = if lo + width < n then lo + width else n
            let hi = if lo + 2 * width < n then lo + 2 * width else n
            var x = lo
            var y = mid
            var k = lo
            while x < mid && y < hi {
                var take_y = false
                if plain {
                    let ky = keys[a[y]]
                    let kx = keys[a[x]]
                    take_y = ky < kx || ky == kx && later(ev[a[x]].nm, ev[a[y]].nm, 8)
                } else {
                    take_y = cmp(o, ev, a[y], a[x]) < 0
                }
                if take_y {
                    tmp[k] = a[y]
                    y += 1
                } else {
                    tmp[k] = a[x]
                    x += 1
                }
                k += 1
            }
            while x < mid {
                tmp[k] = a[x]
                x += 1
                k += 1
            }
            while y < hi {
                tmp[k] = a[y]
                y += 1
                k += 1
            }
            lo = hi
        }
        let sw = a
        a = tmp
        tmp = sw
        width = width * 2
    }
    if plain && o.reverse {
        var x = 0
        var y = n - 1
        while x < y {
            let t = a[x]
            a[x] = a[y]
            a[y] = t
            x += 1
            y -= 1
        }
    }
    a
}

/// A name's first seven bytes, big-endian, as one non-negative `int`
/// (`nm[1..8]`; 0 for a byte past the end).
fn pack(nm: List[byte]) -> int {
    var k: int = 0
    var i = 1
    while i < 8 {
        k = k * 256
        if i < nm.len {
            k += nm[i] as int
        }
        i += 1
    }
    k
}

/// Whether name `x` sorts after name `y`, both equal before position `d`.
fn later(x: List[byte], y: List[byte], d: int) -> bool {
    var i = d
    let nx = x.len
    let ny = y.len
    while i < nx && i < ny {
        let p = x[i] as int
        let q = y[i] as int
        if p != q {
            return p > q
        }
        i += 1
    }
    nx > ny
}

// ---- descent (`src/traverse.c:646`) ----

/// Whether to descend into `e` at `depth`; if not, why: "recursive, not
/// followed" for a followed symlink whose target was already seen, and
/// whether the `-L` limit alone stopped it (`-R`'s boundary).
fn decide(mut w: Walk, o: opts.Opts, e: ent.Ent, depth: int) -> (bool, str, bool) {
    let dl = e.kind == ent.dir() || o.follow && e.kind == ent.lnk() && e.ltype == ent.dir()
    if !dl {
        return (false, "", false)
    }
    var descend = true
    var post = ""
    // tree records every directory before any other check (saveino), so
    // a directory halted at the -L boundary still blocks a later link to
    // it (audit A2)
    if o.follow {
        let (ino, dev) = ent.ident(w.a, e)
        let k = ident(ino, dev)
        if w.seen[k] else false {
            if e.kind == ent.lnk() {
                post = "recursive, not followed"
                descend = false
            }
        } else {
            w.seen[k] = true
        }
    }
    if o.xdev && e.kind == ent.dir() {
        let (_, dev) = ent.ident(w.a, e)
        if dev != w.root_dev {
            return (false, post, false)
        }
    }
    if o.level >= 0 && depth >= o.level {
        return (false, "", true)
    }
    (descend, post, false)
}

// ---- the per-directory filter stacks ----

fn push_dir(mut w: Walk, o: opts.Opts, path: str) -> (bool, bool) {
    var g = false
    if o.gitignore {
        let (ok, ig) = gitignore.load_dir(path)
        if ok {
            (mut w.igs).push(ig)
            g = true
        }
    }
    var f = false
    if o.showinfo {
        let (ok, inf) = infofile.load_dir(path)
        if ok {
            (mut w.infs).push(inf)
            f = true
        }
        w.info_top = ok
    } else {
        w.info_top = false
    }
    (g, f)
}

fn pop_dir(mut w: Walk, g: bool, f: bool) {
    if f {
        let _ = (mut w.infs).pop() else infofile.empty()
    }
    if g {
        let _ = (mut w.igs).pop() else gitignore.empty()
    }
}

// ---- the line renderers (`struct line_renderer`) ----

fn l_root(mut w: Walk, o: opts.Opts, path: str, err: str, st: ent.Meta, ids: ent.Ids, has: bool) {
    if w.fmt == opts.out_html() {
        html.root(mut w.h, o, path, err, st, ids, has)
    } else {
        text.root(mut w.t, o, path, err, st, ids, has)
    }
}

fn l_entry(mut w: Walk, o: opts.Opts, e: ent.Ent, path: str, depth: int, is_last: bool, rd: int) {
    if w.fmt == opts.out_html() {
        html.entry(mut w.h, o, w.a, e, path, depth, is_last, rd)
    } else if e.lnk >= 0 {
        text.entry(mut w.t, o, w.a, e, w.a.lnks[e.lnk], path, depth, is_last)
    } else {
        text.entry(mut w.t, o, w.a, e, w.none, path, depth, is_last)
    }
}

fn l_error(mut w: Walk, msg: str) {
    if w.fmt == opts.out_html() {
        html.error(mut w.h, msg)
    } else {
        text.error(mut w.t, msg)
    }
}

fn l_newline(mut w: Walk) {
    if w.fmt == opts.out_html() {
        html.newline(mut w.h)
    } else {
        text.newline(mut w.t)
    }
}

fn l_comment(mut w: Walk, o: opts.Opts, e: ent.Ent, depth: int) {
    let ii = ent.info_of(w.a, e)
    if ii < 0 || w.fmt == opts.out_html() {
        return
    }
    text.comment(mut w.t, w.a.infos[ii], depth)
}

/// `-R`: re-render `path`'s subtree into `path/00Tree.html` in the same
/// line format (`src/render/unix.c:396`, `src/render/html.c:331`); false
/// when the file cannot be created (an I/O error: status 2, D1).
fn rerun(w: Walk, o: opts.Opts, path: str) -> bool {
    let fd = fs_create("{path}/00Tree.html") else |_| {
        return false
    }
    var sub = make(o, fd, w.env)
    let roots = [path]
    let _ = run(mut sub, o, roots)
    fs_close(fd) else |_| {}
    true
}

// ---- the streaming walk (`src/traverse.c:691`) ----

fn walk_dir(mut w: Walk, o: opts.Opts, path: str, take rows: List[List[byte]], depth: int) {
    let (g, f) = push_dir(mut w, o, path)
    let ev = read_level(mut w, o, path, take rows, take List[ent.Ent](), false)
    let ord = order(o, ev)
    let n = ord.len
    text.begin_level(mut w.t, o, depth)
    let need_path = o.fullpath || w.env.debug || w.fmt == opts.out_html() || o.hyperlink || o.rerun
    var htmldescend = 0
    var i = 0
    while i < n {
        let k = ord[i]
        let is_last = i + 1 == n
        if ent.dir_like(ev[k]) {
            w.dirs += 1
        } else {
            w.files += 1
        }
        let (descend, post, boundary) = decide(mut w, o, ev[k], depth)
        let cp = if descend || need_path then join(path, ev[k].nm) else ""
        if boundary && o.rerun {
            if !rerun(w, o, cp) {
                w.errors += 1
            }
            htmldescend = 10
        }
        l_entry(mut w, o, ev[k], cp, depth, is_last, (if descend then 1 else 0) + htmldescend)
        if descend {
            var opened = true
            let sub = fs_read_dir_entries(cp) else |_| {
                opened = false
                List[List[byte]]()
            }
            if opened {
                l_newline(mut w)
                l_comment(mut w, o, ev[k], depth)
                walk_dir(mut w, o, cp, take sub, depth + 1)
            } else {
                l_error(mut w, "error opening dir")
                l_newline(mut w)
                l_comment(mut w, o, ev[k], depth)
                w.errors += 1
            }
        } else {
            if post.len > 0 {
                l_error(mut w, post)
            }
            l_newline(mut w)
            l_comment(mut w, o, ev[k], depth)
        }
        i += 1
    }
    pop_dir(mut w, g, f)
}

// ---- the full tree ----

/// The answer of `build_level`: the level's entry indices in display
/// order, or (`limit`) the `--filelimit` message that stopped it.
struct Built {
    arr: List[int],
    limit: str,
}

/// The whole subtree of an opened directory into the arena
/// (`src/traverse.c:796`), sorted before the descent so that `-l`'s cycle
/// set sees siblings in display order (D7).
fn build_level(
    mut w: Walk,
    o: opts.Opts,
    path: str,
    take rows: List[List[byte]],
    depth: int,
    suppress: bool,
) -> Built {
    let (g, f) = push_dir(mut w, o, path)
    let ev = read_level(mut w, o, path, take rows, take List[ent.Ent](), suppress)
    let ord = order(o, ev)
    if o.filelimit > 0 && ev.len > o.filelimit {
        // DEVIATION D1: a tripped filelimit is an error in every mode
        w.errors += 1
        pop_dir(mut w, g, f)
        return Built {
            arr: List[int](),
            limit: "{ev.len} entries exceeds filelimit, not opening dir",
        }
    }
    var out = List[int]()
    for k in ord {
        var e = copy ev[k]
        let dl = ent.dir_like(e)
        var child_suppress = suppress
        // --matchdirs: a directory whose name matches -P shows its
        // contents unfiltered and is kept by --prune
        if o.matchdirs && o.patterns.len > 0 && dl {
            let fb = path_bytes(path, e.nm)
            if glob.full(o.patterns, fb, fb.len - (e.nm.len - 1), true, o.ignorecase) {
                e.flags = e.flags | ent.f_matched()
                child_suppress = true
            }
        }
        let (descend, post, _) = decide(mut w, o, e, depth)
        if descend {
            let cp = join(path, e.nm)
            var opened = true
            let sub = fs_read_dir_entries(cp) else |_| {
                opened = false
                List[List[byte]]()
            }
            if opened {
                let b = build_level(mut w, o, cp, take sub, depth + 1, child_suppress)
                if b.limit.len > 0 {
                    e.err = b.limit
                } else {
                    e.child = w.a.kids.len
                    (mut w.a.kids).push(b.arr)
                }
            } else {
                e.err = "error opening dir"
                w.errors += 1
            }
        } else if post.len > 0 {
            e.err = post
            e.flags = e.flags | ent.f_recursive()
        }
        (mut w.a.ents).push(e)
        (mut out).push(w.a.ents.len - 1)
    }
    pop_dir(mut w, g, f)
    Built { arr: out, limit: "" }
}

/// `--condense` on one entry (`src/traverse.c:911`): a directory whose
/// only child is a directory absorbs it, the names joined with `/`,
/// until the chain ends; under `--du` each absorbed directory's own size
/// is folded in.
fn condense_entry(mut w: Walk, o: opts.Opts, k: int) {
    loop {
        let c = w.a.ents[k].child
        if c < 0 || w.a.kids[c].len != 1 {
            break
        }
        let only = w.a.kids[c][0]
        if !ent.dir_like(w.a.ents[only]) {
            break
        }
        var joined = shown(w.a, w.a.ents[k])
        (mut joined).push(47 as byte)
        let tail = shown(w.a, w.a.ents[only])
        var i = 1
        while i < tail.len {
            (mut joined).push(tail[i])
            i += 1
        }
        if w.a.ents[k].x < 0 {
            w.a.ents[k].x = ent.new_x(mut w.a)
        }
        let xi = w.a.ents[k].x
        w.a.xs[xi].cname = w.a.cnames.len
        (mut w.a.cnames).push(joined)
        if o.duflag && w.a.ents[k].has_st && w.a.ents[only].has_st {
            w.a.ents[k].st.size = w.a.ents[k].st.size + w.a.ents[only].st.size
        }
        w.a.ents[k].child = w.a.ents[only].child
        w.a.xs[xi].cond = w.a.xs[xi].cond + 1 + ent.cond_of(w.a, w.a.ents[only])
    }
}

/// `--condense` and `--prune`'s bottom-up pass (`src/traverse.c:940`),
/// interleaved as tree does: a node's subtree first, then the node is
/// condensed, then its parent drops it when it ended up empty.
fn condense_prune(mut w: Walk, o: opts.Opts, arr: List[int], do_prune: bool) -> List[int] {
    var keep = List[int]()
    for k in arr {
        let dl = ent.dir_like(w.a.ents[k])
        let c = w.a.ents[k].child
        if dl && c >= 0 {
            let kids = copy w.a.kids[c]
            let kept = condense_prune(mut w, o, kids, do_prune)
            w.a.kids[c] = kept
        }
        if o.condense && w.a.ents[k].kind == ent.dir() {
            condense_entry(mut w, o, k)
        }
        if do_prune {
            let c2 = w.a.ents[k].child
            let empty = dl && (c2 < 0 || w.a.kids[c2].len == 0)
            if empty && w.a.ents[k].flags & ent.f_matched() == 0 {
                continue
            }
        }
        (mut keep).push(k)
    }
    keep
}

/// `--du`'s bottom-up sizes (`src/traverse.c:969`): a directory's size
/// is its own plus its contents'; the level's total.
fn du_level(mut w: Walk, arr: List[int]) -> int {
    var sum: int = 0
    for k in arr {
        let dl = ent.dir_like(w.a.ents[k])
        if dl && w.a.ents[k].child >= 0 && w.a.ents[k].has_st {
            let kids = copy w.a.kids[w.a.ents[k].child]
            let sub = du_level(mut w, kids)
            w.a.ents[k].st.size = w.a.ents[k].st.size + sub
        }
        if w.a.ents[k].has_st {
            sum += w.a.ents[k].st.size
        }
    }
    sum
}

/// Emit a built level to a line renderer (`src/traverse.c:984`).
fn emit_level(mut w: Walk, o: opts.Opts, path: str, arr: List[int], depth: int) {
    let n = arr.len
    text.begin_level(mut w.t, o, depth)
    var htmldescend = 0
    var i = 0
    while i < n {
        let k = arr[i]
        let is_last = i + 1 == n
        let e = copy w.a.ents[k]
        let dl = ent.dir_like(e)
        if dl {
            w.dirs += 1 + ent.cond_of(w.a, e)
        } else {
            w.files += 1
        }
        let cp = join_shown(path, w.a, e)
        let rd = if e.child >= 0 then 1 else 0
        if dl &&
            e.child < 0 &&
            e.err.len == 0 &&
            o.rerun &&
            o.level >= 0 &&
            depth >= o.level &&
            !(o.xdev && e.kind == ent.dir() && ent.ids(w.a, e).dev != w.root_dev) {
            if !rerun(w, o, cp) {
                w.errors += 1
            }
            htmldescend = 10
        }
        l_entry(mut w, o, e, cp, depth, is_last, rd + htmldescend)
        if e.child >= 0 {
            l_newline(mut w)
            l_comment(mut w, o, e, depth)
            let kids = copy w.a.kids[e.child]
            emit_level(mut w, o, cp, kids, depth + 1)
        } else {
            if e.err.len > 0 {
                l_error(mut w, e.err)
            }
            l_newline(mut w)
            l_comment(mut w, o, e, depth)
        }
        i += 1
    }
}

// ---- roots ----

/// tree strips every trailing `/` from a root (one stays on `/`).
fn strip_slashes(p: str) -> str {
    var s = p
    while s.len > 1 && s.ends_with("/") {
        s = s[0..s.len - 1]
    }
    s
}

fn root_meta(path: str) -> (bool, ent.Meta, ent.Ids) {
    var ok = true
    let m = fs_lstat(path) else |_| {
        ok = false
        List[int]()
    }
    if !ok {
        return (false, ent.no_meta(), ent.no_ids())
    }
    (true, ent.meta_of(m), ent.ids_of(m))
}

fn t_tree(
    mut w: Walk,
    o: opts.Opts,
    root: str,
    st: ent.Meta,
    ids: ent.Ids,
    has: bool,
    opened: bool,
    limit: str,
    top: List[int],
    last: bool,
) {
    if w.fmt == opts.out_json() {
        let (a, b) = json.tree(mut w.j, o, root, st, ids, has, opened, limit, w.a, top, last)
        w.dirs += a
        w.files += b
    } else {
        let (a, b) = xml.tree(mut w.x, o, root, st, ids, has, opened, limit, w.a, top, last)
        w.dirs += a
        w.files += b
    }
}

/// `--gitignore`'s walk up from a root (tree 2.3.2's manual: it "attempts
/// to walk up the directory tree from the given path(s) searching for
/// .gitignore files as it goes, stopping at / or a directory containing a
/// .git directory. If a .git directory is found it will add the
/// .git/info/exclude file as well"). C aspen does not walk up
/// (`src/filter.h:11`, "NOT YET"), and no golden covers it, so the port
/// follows tree, measured in the oracle's container: the root itself is
/// asked for a `.git` first; an ancestor's absolute patterns match no
/// entry (its base is the root's path with `/..` appended, as here, which
/// no entry's path is); the root's own `.gitignore` is the listing's.
fn git_walk_up(mut w: Walk, root: str) {
    var cur = root
    var k = 0
    while k < 4096 {
        if k > 0 {
            let (ok, ig) = gitignore.load_dir(cur)
            if ok {
                (mut w.igs).push(ig)
            }
        }
        if fs_is_dir("{cur}/.git") {
            let (ok, ig) = gitignore.load_file(cur, "{cur}/.git/info/exclude")
            if ok {
                (mut w.igs).push(ig)
            }
            return
        }
        let rp = fs_realpath(cur) else |_| {
            return
        }
        if rp == "/" {
            return
        }
        cur = "{cur}/.."
        k += 1
    }
}

/// The per-root state, fresh (`asp_walk`'s wctx).
fn reset_root(mut w: Walk) {
    w.a = ent.arena()
    w.seen = Map[str, bool]()
    w.root_dev = 0
    w.igs = List[gitignore.Ignore]()
    w.infs = List[infofile.Info]()
    w.info_top = false
}

/// One root (`src/traverse.c:1242`).
pub fn root(mut w: Walk, o: opts.Opts, root: str, last_root: bool) {
    if o.fromfile || o.fromtabfile {
        root_fromfile(mut w, o, root, last_root)
        return
    }
    let dr = if o.fullpath then strip_slashes(root) else root
    let cpath = strip_slashes(root)
    var opened = true
    let rows = fs_read_dir_entries(root) else |_| {
        opened = false
        List[List[byte]]()
    }
    if !opened {
        // tree lstats a root it cannot open: one that exists is shown
        // "[error opening dir]" and counted as one file, status 0; one
        // that does not is an error, status 2 (`src/traverse.c:1268`)
        let (has, st, rids) = root_meta(root)
        if is_tree_fmt(w) {
            t_tree(mut w, o, dr, st, rids, has, false, "", List[int](), last_root)
        } else {
            l_root(mut w, o, dr, "error opening dir", st, rids, has)
        }
        if has {
            w.files += 1
            // tree adds the root's own size to --du's total even when it
            // cannot open it; C aspen does not (docs/MAP.md §5)
            if o.duflag {
                w.size += st.size
            }
        } else {
            w.errors += 1
        }
        return
    }
    reset_root(mut w)
    // --gitfile's patterns: tree's base for their absolute ones is not
    // the working directory (measured: `/r/c.c` in one does not hide
    // `./r/c.c`), so it is the file's own path here, as an info file's is
    for gf in o.gitfiles {
        let (ok, ig) = gitignore.load_file(gf, gf)
        if ok {
            (mut w.igs).push(ig)
        }
    }
    if o.gitignore {
        git_walk_up(mut w, cpath)
        var have = true
        let gd = env_get("GIT_DIR") else |_| {
            have = false
            ""
        }
        if have {
            let (ok, ig) = gitignore.load_file(gd, "{gd}/info/exclude")
            if ok {
                (mut w.igs).push(ig)
            }
        }
    }
    for inff in o.infofiles {
        let (ok, inf) = infofile.load_file(inff)
        if ok {
            (mut w.infs).push(inf)
        }
    }
    if o.showinfo {
        let (ok, inf) = infofile.load_file("/usr/share/finfo/global_info")
        if ok {
            (mut w.infs).push(inf)
        }
    }
    if o.xdev || o.follow {
        var ok = true
        let ws = fs_stat(root) else |_| {
            ok = false
            List[int]()
        }
        if ok {
            w.root_dev = ws[9]
            if o.follow {
                w.seen[ident(ws[10], ws[9])] = true
            }
        }
    }
    // the root's own line shows its lstat (`src/traverse.c:1342`); -J and
    // -X type the root by it too: tree calls a symlink to a directory
    // "link" (C aspen says "directory" when no flag stat'ed it,
    // `src/render/json.c:294`; docs/MAP.md §5)
    var has_st = false
    var st = ent.no_meta()
    var rids = ent.no_ids()
    let rstat = root_needs_stat(o)
    if rstat || is_tree_fmt(w) || w.fmt == opts.out_html() {
        let (h, s, si) = root_meta(root)
        has_st = h && rstat
        if h {
            let kind = s.kind
            rids = si
            st = s
            if !rstat {
                st = ent.no_meta()
                st.kind = kind
            }
        }
    }
    if is_tree_fmt(w) || full_tree(o) {
        let b = build_level(mut w, o, cpath, take rows, 1, false)
        if b.limit.len > 0 {
            // SR-2.12: the root itself over --filelimit, one directory
            if is_tree_fmt(w) {
                t_tree(mut w, o, dr, st, rids, has_st, true, b.limit, List[int](), last_root)
            } else {
                l_root(mut w, o, dr, b.limit, st, rids, has_st)
                w.dirs += 1
            }
            return
        }
        var top = b.arr
        let do_prune = o.prune && !o.dirsonly
        if o.condense || do_prune {
            let kept = condense_prune(mut w, o, top, do_prune)
            top = kept
        }
        if o.duflag {
            let dusum = du_level(mut w, top)
            // tree sums every root's total; C aspen SETS it per root, so
            // several roots report only the last one's (`src/traverse.c:1378`;
            // docs/MAP.md §5)
            if has_st {
                st.size = st.size + dusum
                w.size += st.size
            } else {
                w.size += dusum
            }
        }
        if is_tree_fmt(w) {
            t_tree(mut w, o, dr, st, rids, has_st, true, "", top, last_root)
        } else {
            l_root(mut w, o, dr, "", st, rids, has_st)
            if top.len > 0 {
                w.dirs += 1
            }
            emit_level(mut w, o, cpath, top, 1)
        }
        return
    }
    let before = w.dirs + w.files
    l_root(mut w, o, dr, "", st, rids, has_st)
    walk_dir(mut w, o, cpath, take rows, 1)
    if w.dirs + w.files > before {
        w.dirs += 1
    }
}

// ---- --fromfile (`src/traverse.c:1057`) ----

/// A level of the input's nodes into entries, with the listing's filters
/// (`synth_level`): `-a`, `-d`, and `-P`/`-I` on the name alone; a
/// directory whose name matches `-P` shows its subtree unfiltered and is
/// kept by `--prune` (tree's fromfile quirk, not gated on `--matchdirs`).
/// Entries carry only their type (`newent()`). The level comes back in
/// display order (the C sorts it as it emits, `src/traverse.c:990`).
fn synth_level(
    mut w: Walk,
    o: opts.Opts,
    t: fromfile.Tree,
    list: List[int],
    suppress: bool,
) -> List[int] {
    let need = want_st(o)
    var out = List[int]()
    var ev = List[ent.Ent]()
    for id in list {
        let isdir = t.nodes[id].isdir
        let islink = t.nodes[id].islink
        let kind = if islink then ent.lnk() else if isdir then ent.dir() else ent.reg()
        let nm = copy t.nodes[id].name
        if !o.all && nm.len > 0 && nm[0] as int == 46 {
            continue
        }
        if o.dirsonly && !isdir {
            continue
        }
        var matched = false
        let row = row_of(nm)
        if !suppress {
            if o.patterns.len > 0 {
                let any = glob.any(o.patterns, row, 1, row.len, isdir, o.ignorecase)
                if !isdir {
                    if !any {
                        continue
                    }
                } else if any {
                    matched = true
                }
            }
            if o.ipatterns.len > 0 && glob.any(o.ipatterns, row, 1, row.len, isdir, o.ignorecase) {
                continue
            }
        }
        var e = ent.new_ent(take row, kind)
        if matched {
            e.flags = e.flags | ent.f_matched()
        }
        if islink {
            e.lnk = w.a.lnks.len
            (mut w.a.lnks).push(copy t.nodes[id].lnk)
        }
        if need {
            var m = ent.no_meta()
            m.kind = kind
            e.st = m
            e.has_st = true
        }
        if isdir && t.nodes[id].kids.len > 0 {
            let ch = synth_level(mut w, o, t, t.nodes[id].kids, suppress || matched)
            if ch.len > 0 {
                e.child = w.a.kids.len
                (mut w.a.kids).push(ch)
            }
        }
        (mut ev).push(copy e)
        (mut w.a.ents).push(e)
        (mut out).push(w.a.ents.len - 1)
    }
    let ord = order(o, ev)
    var sorted = List[int]()
    for i in ord {
        (mut sorted).push(out[i])
    }
    sorted
}

fn root_fromfile(mut w: Walk, o: opts.Opts, arg: str, last_root: bool) {
    // the root's metadata is the input file's own lstat, its size shown 0
    let (has, st0, fids) = root_meta(arg)
    var st = st0
    st.size = 0
    let dr = if o.fullpath then strip_slashes(arg) else arg
    let (_, t) = fromfile.read(arg, o.fromtabfile, o.fflinks)
    for e in t.errs {
        eprint_raw(e)
    }
    if !has {
        if is_tree_fmt(w) {
            t_tree(mut w, o, dr, st, fids, false, false, "", List[int](), last_root)
        } else {
            l_root(mut w, o, dr, "error opening dir", st, fids, false)
        }
        w.errors += 1
        return
    }
    reset_root(mut w)
    var top = synth_level(mut w, o, t, t.nodes[0].kids, false)
    let do_prune = o.prune && !o.dirsonly
    if o.condense || do_prune {
        let kept = condense_prune(mut w, o, top, do_prune)
        top = kept
    }
    if o.duflag {
        // tree: the root's size is the aggregate alone
        let dusum = du_level(mut w, top)
        st.size = dusum
        w.size += dusum
    }
    if is_tree_fmt(w) {
        t_tree(mut w, o, dr, st, fids, true, true, "", top, last_root)
    } else {
        l_root(mut w, o, dr, "", st, fids, true)
        w.dirs += 1
        emit_level(mut w, o, dr, top, 1)
    }
}

/// Every root, the report, the end (`src/render.c:4`); the exit status:
/// 2 when any open or stat failed, else 0.
pub fn run(mut w: Walk, o: opts.Opts, roots: List[str]) -> int {
    if w.fmt == opts.out_json() {
        json.begin(mut w.j, o)
    } else if w.fmt == opts.out_xml() {
        xml.begin(mut w.x, o)
    } else if w.fmt == opts.out_html() {
        html.begin(mut w.h, o)
    }
    let n = roots.len
    var i = 0
    while i < n {
        root(mut w, o, roots[i], i + 1 == n)
        i += 1
    }
    if !o.noreport {
        if w.fmt == opts.out_json() {
            json.report(mut w.j, o, w.dirs, w.files, w.size)
        } else if w.fmt == opts.out_xml() {
            xml.report(mut w.x, o, w.dirs, w.files, w.size)
        } else if w.fmt == opts.out_html() {
            html.report(mut w.h, o, w.dirs, w.files, w.size)
        } else {
            text.report(mut w.t, o, w.dirs, w.files, w.size)
        }
    }
    if w.fmt == opts.out_json() {
        json.end(mut w.j, o)
    } else if w.fmt == opts.out_xml() {
        xml.end(mut w.x, o)
    } else if w.fmt == opts.out_html() {
        html.end(mut w.h, o)
    } else {
        text.finish(mut w.t)
    }
    if w.errors > 0 then 2 else 0
}

// ---- --asp-diff (C aspen's own extension, `src/diff.c`) ----

/// One merged entry: added (0), removed (1), modified (2) or unchanged
/// (3); the entry on each side (arena index, -1 none), its children.
struct Dent {
    status: int,
    a: int,
    b: int,
    kids: List[int],
}

fn d_added() -> int {
    0
}

fn d_removed() -> int {
    1
}

fn d_modified() -> int {
    2
}

fn d_unchanged() -> int {
    3
}

/// Whether two entries of one name differ (`entries_differ`,
/// `src/diff.c:69`): the type, the size, the time, the mode, the target.
fn entries_differ(aa: ent.Arena, ea: ent.Ent, ab: ent.Arena, eb: ent.Ent) -> bool {
    if ea.kind != eb.kind {
        return true
    }
    if ea.has_st && eb.has_st {
        if ea.st.size != eb.st.size || ea.st.mtime != eb.st.mtime || ea.st.mode != eb.st.mode {
            return true
        }
    } else if ea.has_st != eb.has_st {
        return true
    }
    if ea.lnk >= 0 && eb.lnk >= 0 {
        return namecmp(row_of(aa.lnks[ea.lnk]), row_of(ab.lnks[eb.lnk])) != 0
    }
    (ea.lnk >= 0) != (eb.lnk >= 0)
}

/// A whole subtree marked one way (`annotate_subtree`, `src/diff.c:192`).
fn annotate(mut ds: List[Dent], ar: ent.Arena, arr: List[int], status: int) -> List[int] {
    var out = List[int]()
    for k in arr {
        let c = ar.ents[k].child
        var kids = List[int]()
        if c >= 0 {
            kids = annotate(mut ds, ar, ar.kids[c], status)
        }
        let a = if status == d_removed() then k else -1
        let b = if status == d_added() then k else -1
        (mut ds).push(Dent { status: status, a: a, b: b, kids: kids })
        (mut out).push(ds.len - 1)
    }
    out
}

fn kids_of(ar: ent.Arena, k: int) -> List[int] {
    let c = ar.ents[k].child
    if c < 0 then List[int]() else copy ar.kids[c]
}

/// Two levels, both in name order, merged (`merge_level`, `src/diff.c:129`;
/// names compared by byte, as aspen sorts them).
fn merge(
    mut ds: List[Dent],
    aa: ent.Arena,
    xs: List[int],
    ab: ent.Arena,
    ys: List[int],
) -> List[int] {
    var out = List[int]()
    var i = 0
    var j = 0
    while i < xs.len && j < ys.len {
        let ea = copy aa.ents[xs[i]]
        let eb = copy ab.ents[ys[j]]
        let c = namecmp(ea.nm, eb.nm)
        if c < 0 {
            let kids = annotate(mut ds, aa, kids_of(aa, xs[i]), d_removed())
            (mut ds).push(Dent { status: d_removed(), a: xs[i], b: -1, kids: kids })
            (mut out).push(ds.len - 1)
            i += 1
        } else if c > 0 {
            let kids = annotate(mut ds, ab, kids_of(ab, ys[j]), d_added())
            (mut ds).push(Dent { status: d_added(), a: -1, b: ys[j], kids: kids })
            (mut out).push(ds.len - 1)
            j += 1
        } else {
            let adir = ent.dir_like(ea)
            let bdir = ent.dir_like(eb)
            var st = d_unchanged()
            var kids = List[int]()
            if adir && bdir {
                kids = merge(mut ds, aa, kids_of(aa, xs[i]), ab, kids_of(ab, ys[j]))
                if entries_differ(aa, ea, ab, eb) {
                    st = d_modified()
                }
            } else if adir != bdir {
                st = d_modified()
                if bdir && eb.child >= 0 {
                    kids = annotate(mut ds, ab, kids_of(ab, ys[j]), d_added())
                } else if adir && ea.child >= 0 {
                    kids = annotate(mut ds, aa, kids_of(aa, xs[i]), d_removed())
                }
            } else if entries_differ(aa, ea, ab, eb) {
                st = d_modified()
            }
            (mut ds).push(Dent { status: st, a: xs[i], b: ys[j], kids: kids })
            (mut out).push(ds.len - 1)
            i += 1
            j += 1
        }
    }
    while i < xs.len {
        let kids = annotate(mut ds, aa, kids_of(aa, xs[i]), d_removed())
        (mut ds).push(Dent { status: d_removed(), a: xs[i], b: -1, kids: kids })
        (mut out).push(ds.len - 1)
        i += 1
    }
    while j < ys.len {
        let kids = annotate(mut ds, ab, kids_of(ab, ys[j]), d_added())
        (mut ds).push(Dent { status: d_added(), a: -1, b: ys[j], kids: kids })
        (mut out).push(ds.len - 1)
        j += 1
    }
    out
}

fn has_changes(ds: List[Dent], arr: List[int]) -> bool {
    for k in arr {
        if ds[k].status != d_unchanged() || has_changes(ds, ds[k].kids) {
            return true
        }
    }
    false
}

fn shows(ds: List[Dent], k: int) -> bool {
    ds[k].status != d_unchanged() || has_changes(ds, ds[k].kids)
}

/// The counts the report prints.
struct Dtot {
    added: int,
    removed: int,
    modified: int,
}

/// One merged level (`diff_emit_level`, `src/diff.c:302`): only what
/// changed or holds a change, each with its marker.
fn diff_level(
    mut w: Walk,
    o: opts.Opts,
    ds: List[Dent],
    aa: ent.Arena,
    ab: ent.Arena,
    arr: List[int],
    depth: int,
    mut tot: Dtot,
) {
    var vis = 0
    for k in arr {
        if shows(ds, k) {
            vis += 1
        }
    }
    var vi = 0
    text.begin_level(mut w.t, o, depth)
    for k in arr {
        if !shows(ds, k) {
            continue
        }
        vi += 1
        let s = ds[k].status
        if ds[k].b >= 0 {
            text.diff_line(mut w.t, o, s, ab, copy ab.ents[ds[k].b], depth, vi == vis)
        } else {
            text.diff_line(mut w.t, o, s, aa, copy aa.ents[ds[k].a], depth, vi == vis)
        }
        if s == d_added() {
            tot.added += 1
        } else if s == d_removed() {
            tot.removed += 1
        } else if s == d_modified() {
            tot.modified += 1
        }
        diff_level(mut w, o, ds, aa, ab, ds[k].kids, depth + 1, mut tot)
    }
}

/// `--asp-diff A B` (`asp_diff_run`, `src/diff.c:340`): both trees built
/// with every entry stat'ed and in name order, merged, the changes shown
/// under `A -> B`, and a count of each kind. 2 when a root cannot be
/// opened.
pub fn diff(mut w: Walk, o0: opts.Opts, ra: str, rb: str) -> int {
    var o = copy o0
    o.sizeflag = true
    o.sort = opts.sort_name()
    o.reverse = false
    o.dirsfirst = false
    o.filesfirst = false
    var fail = false
    var opened_a = true
    let rows_a = fs_read_dir_entries(ra) else |_| {
        opened_a = false
        List[List[byte]]()
    }
    if !opened_a {
        eprint_raw("aspen: cannot open '{ra}'\n")
        fail = true
    }
    var opened_b = true
    let rows_b = fs_read_dir_entries(rb) else |_| {
        opened_b = false
        List[List[byte]]()
    }
    if !opened_b {
        eprint_raw("aspen: cannot open '{rb}'\n")
        fail = true
    }
    if fail {
        return 2
    }
    reset_root(mut w)
    let ta = build_level(mut w, o, strip_slashes(ra), take rows_a, 1, false)
    let aa = copy w.a
    reset_root(mut w)
    let tb = build_level(mut w, o, strip_slashes(rb), take rows_b, 1, false)
    let ab = copy w.a
    var ds = List[Dent]()
    let top = merge(mut ds, aa, ta.arr, ab, tb.arr)
    text.diff_head(mut w.t, ra, rb)
    var tot = Dtot { added: 0, removed: 0, modified: 0 }
    diff_level(mut w, o, ds, aa, ab, top, 1, mut tot)
    if !o.noreport {
        text.diff_report(mut w.t, tot.added, tot.removed, tot.modified)
    }
    text.finish(mut w.t)
    0
}
