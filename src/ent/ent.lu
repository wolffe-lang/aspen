//! ent — one directory entry (C aspen `src/entry.h`), and the type codes.
//!
//! The type codes are wolf-std's (`std.fs.Info.kind`, the order
//! `fs_read_dir_entries` reports them in): 0 regular file, 1 directory,
//! 2 anything the host does not name (C aspen's ASP_UNKNOWN; resolved by
//! an `lstat`), 3 symbolic link, 4 fifo, 5 socket, 6 character device,
//! 7 block device.
//!
//! The name is kept as the bytes the host gave (`nm`, the row
//! `fs_read_dir_entries` returned: `nm[0]` is the type byte and the name
//! is `nm[1..]`), so a listing never copies or decodes a name it only
//! prints. A path is built (`str`) only for an entry aspen opens or
//! stats; a name that is not UTF-8 cannot be one (wolf paths are `str`,
//! wolf-lang#687), which no golden or fuzzer name is.

/// A regular file.
pub fn reg() -> int {
    0
}

/// A directory.
pub fn dir() -> int {
    1
}

/// A type the host did not name (resolved by an `lstat`).
pub fn unknown() -> int {
    2
}

/// A symbolic link.
pub fn lnk() -> int {
    3
}

/// A named pipe.
pub fn fifo() -> int {
    4
}

/// A socket.
pub fn sock() -> int {
    5
}

/// A character device.
pub fn chr() -> int {
    6
}

/// A block device.
pub fn blk() -> int {
    7
}

// Flags (`src/entry.h:17`).
/// A dangling symlink (`ENT_ORPHAN`).
pub fn f_orphan() -> int {
    2
}

/// A regular file with an execute bit (`-F`'s `*`, `ENT_EXEC`).
pub fn f_exec() -> int {
    4
}

/// A symlink whose target is an executable file (`ENT_LEXEC`).
pub fn f_lexec() -> int {
    8
}

/// A directory whose name `--matchdirs` matched: kept by `--prune`.
pub fn f_matched() -> int {
    16
}

/// A deferred stat failed: dropped, in order (`ENT_STAT_FAILED`).
pub fn f_stat_failed() -> int {
    32
}

/// `-l`: a symlink whose target was already seen, "recursive, not
/// followed" (`ENT_RECURSIVE`): `-J`/`-X` close it with the entry's own
/// indent.
pub fn f_recursive() -> int {
    64
}

/// The metadata C aspen keeps (`src/sys/xstat.h:24`) that the columns
/// and sorts read most: the type, the 0o7777 permission bits, the size,
/// the two times. The owners and the identity are `Ids`, kept beside the
/// entry only when a flag reads them.
pub struct Meta {
    kind: int,
    mode: int,
    size: int,
    mtime: int,
    ctime: int,
}

/// The owners and the identity (`-u`, `-g`, `--inodes`, `--device`, and
/// `-x`'s and `-l`'s checks).
pub struct Ids {
    uid: int,
    gid: int,
    ino: int,
    dev: int,
}

/// What few entries carry, in the arena's `xs`: `--info`'s lines and
/// `--condense`'s joined name (their indices, -1 none) and how many
/// directories it folded, the owners and identity (`has_ids`).
pub struct Extra {
    info: int,
    cname: int,
    cond: int,
    ids: Ids,
    has_ids: bool,
}

/// A symlink target's mode and identity, beside its text in the arena.
pub struct Lst {
    mode: int,
    ino: int,
    dev: int,
}

/// One entry: its name's bytes (`nm`, the host's row), its type, a
/// symlink's target type, the flags, the metadata when a flag stat'ed it,
/// and in the built tree the error that stopped its descent. The rest
/// lives in the arena's side tables, by index (-1: none), so an entry
/// carries no empty list (two allocations an entry, measured:
/// docs/MAP.md) and stays small (its size is the listing's cost: ap01
/// measured 13 more words at 15% of the 100,000-file listing): `lnk` a
/// symlink's target (`lnks`, `lstats`), `child` a built directory's
/// children (`kids`), `x` the rare fields (`xs`), and `col` the bracket
/// column a stat task formatted (`coltxt[col / 2^44]`, at `col / 2^20 %
/// 2^24`, `col % 2^20` bytes).
pub struct Ent {
    nm: List[byte],
    kind: int,
    ltype: int,
    flags: int,
    lnk: int,
    st: Meta,
    has_st: bool,
    child: int,
    err: str,
    x: int,
    col: int,
}

/// The built tree's arena (C aspen's per-root arena, `src/arena.c`):
/// the entries, and the side tables their indices name: link targets and
/// their stats, children lists, `--info` lines, `--condense`'s joined
/// names (each a row: byte 0 a placeholder, the name after it), the rare
/// fields, the stat tasks' formatted columns.
pub struct Arena {
    ents: List[Ent],
    lnks: List[List[byte]],
    lstats: List[Lst],
    kids: List[List[int]],
    infos: List[List[List[byte]]],
    cnames: List[List[byte]],
    xs: List[Extra],
    coltxt: List[str],
}

/// An empty arena.
pub fn arena() -> Arena {
    Arena {
        ents: List[Ent](),
        lnks: List[List[byte]](),
        lstats: List[Lst](),
        kids: List[List[int]](),
        infos: List[List[List[byte]]](),
        cnames: List[List[byte]](),
        xs: List[Extra](),
        coltxt: List[str](),
    }
}

/// Metadata nobody read (`has_st` false beside it).
pub fn no_meta() -> Meta {
    Meta { kind: 2, mode: 0, size: 0, mtime: 0, ctime: 0 }
}

/// No owners, no identity.
pub fn no_ids() -> Ids {
    Ids { uid: 0, gid: 0, ino: 0, dev: 0 }
}

/// A `Meta` from the twenty words `fs_lstat`/`fs_stat` answer
/// (`std.fs.Info`'s table: 0 kind, 1 size, 4 mode, 14 mtime s, 16 ctime
/// s).
pub fn meta_of(w: List[int]) -> Meta {
    Meta { kind: w[0], mode: w[4], size: w[1], mtime: w[14], ctime: w[16] }
}

/// The `Ids` of the twenty words (6 uid, 7 gid, 10 ino, 9 dev).
pub fn ids_of(w: List[int]) -> Ids {
    Ids { uid: w[6], gid: w[7], ino: w[10], dev: w[9] }
}

/// A fresh entry of type `kind` named by the row `nm`.
pub fn new_ent(take nm: List[byte], kind: int) -> Ent {
    Ent {
        nm: nm,
        kind: kind,
        ltype: -1,
        flags: 0,
        lnk: -1,
        st: no_meta(),
        has_st: false,
        child: -1,
        err: "",
        x: -1,
        col: -1,
    }
}

fn no_extra() -> Extra {
    Extra { info: -1, cname: -1, cond: 0, ids: no_ids(), has_ids: false }
}

/// `e`'s rare fields (the empty ones when it has none).
pub fn extra(a: Arena, e: Ent) -> Extra {
    if e.x < 0 {
        return no_extra()
    }
    copy a.xs[e.x]
}

/// Give `e` a slot in `a.xs` if it has none, and answer its index.
pub fn ensure_x(mut a: Arena, mut e: Ent) -> int {
    if e.x < 0 {
        e.x = a.xs.len
        (mut a.xs).push(no_extra())
    }
    e.x
}

/// A fresh slot in `a.xs`, its index.
pub fn new_x(mut a: Arena) -> int {
    (mut a.xs).push(no_extra())
    a.xs.len - 1
}

/// `e`'s `--info` lines' index, -1 for none.
pub fn info_of(a: Arena, e: Ent) -> int {
    if e.x < 0 then -1 else a.xs[e.x].info
}

/// `e`'s `--condense` name's index, -1 for none.
pub fn cname_of(a: Arena, e: Ent) -> int {
    if e.x < 0 then -1 else a.xs[e.x].cname
}

/// How many directories `--condense` folded into `e`.
pub fn cond_of(a: Arena, e: Ent) -> int {
    if e.x < 0 then 0 else a.xs[e.x].cond
}

/// `e`'s owners and identity, zero when no flag read them.
pub fn ids(a: Arena, e: Ent) -> Ids {
    if e.x < 0 then no_ids() else a.xs[e.x].ids
}

/// The identity `-l` and `-x` check: a link's target's, else the
/// entry's own.
pub fn ident(a: Arena, e: Ent) -> (int, int) {
    if e.lnk >= 0 {
        let l = a.lstats[e.lnk]
        return (l.ino, l.dev)
    }
    let i = ids(a, e)
    (i.ino, i.dev)
}

/// A symlink's target's permission bits (0 for none or a dangling one).
pub fn lmode(a: Arena, e: Ent) -> int {
    if e.lnk < 0 then 0 else a.lstats[e.lnk].mode
}

/// A symlink to a directory counts and sorts as a directory (tree, all
/// modes; `src/traverse.c:732`).
pub fn dir_like(e: Ent) -> bool {
    e.kind == 1 || e.kind == 3 && e.ltype == 1
}

/// tree's long type name (`src/entry.c:5`), for `-J`.
pub fn type_name(kind: int) -> str {
    match kind {
        0 => "file",
        1 => "directory",
        3 => "link",
        4 => "fifo",
        5 => "socket",
        6 => "char",
        7 => "block",
        _ => "unknown",
    }
}
