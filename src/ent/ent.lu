//! ent — one directory entry (C aspen `src/entry.h`), and the type codes.
//!
//! The type codes are wolf-std's (`std.fs.Info.kind`, the order
//! `fs_read_dir_entries` reports them in): 0 regular file, 1 directory,
//! 2 anything the host does not name (C aspen's ASP_UNKNOWN; resolved by
//! an `lstat`), 3 symbolic link, 4 fifo, 5 socket, 6 character device,
//! 7 block device.
//!
//! The name is kept as the bytes the host gave (`nm`, the row
//! `fs_read_dir_entries` returned: `nm[0]` is the type byte and the name
//! is `nm[1..]`), so a listing never copies or decodes a name it only
//! prints. A path is built (`str`) only for an entry aspen opens or
//! stats; a name that is not UTF-8 cannot be one (wolf paths are `str`,
//! wolf-lang#687), which no golden or fuzzer name is.

/// A regular file.
pub fn reg() -> int {
    0
}

/// A directory.
pub fn dir() -> int {
    1
}

/// A type the host did not name (resolved by an `lstat`).
pub fn unknown() -> int {
    2
}

/// A symbolic link.
pub fn lnk() -> int {
    3
}

/// A named pipe.
pub fn fifo() -> int {
    4
}

/// A socket.
pub fn sock() -> int {
    5
}

/// A character device.
pub fn chr() -> int {
    6
}

/// A block device.
pub fn blk() -> int {
    7
}

// Flags (`src/entry.h:17`).
/// A dangling symlink (`ENT_ORPHAN`).
pub fn f_orphan() -> int {
    2
}

/// A regular file with an execute bit (`-F`'s `*`, `ENT_EXEC`).
pub fn f_exec() -> int {
    4
}

/// A symlink whose target is an executable file (`ENT_LEXEC`).
pub fn f_lexec() -> int {
    8
}

/// A directory whose name `--matchdirs` matched: kept by `--prune`.
pub fn f_matched() -> int {
    16
}

/// A deferred stat failed: dropped, in order (`ENT_STAT_FAILED`).
pub fn f_stat_failed() -> int {
    32
}

/// `-l`: a symlink whose target was already seen, "recursive, not
/// followed" (`ENT_RECURSIVE`): `-J`/`-X` close it with the entry's own
/// indent.
pub fn f_recursive() -> int {
    64
}

/// The metadata C aspen keeps (`src/sys/xstat.h:24`): what the columns
/// and sorts read. `mode` is the permission bits (0o7777), the type is
/// `kind`; `uid`, `gid`, `ino` and `dev` are the host's numbers.
pub struct Meta {
    kind: int,
    mode: int,
    size: int,
    mtime: int,
    ctime: int,
    uid: int,
    gid: int,
    ino: int,
    dev: int,
}

/// One entry: its name's bytes (`nm`, the host's row), its type, a
/// symlink's target type and permission bits, the flags, the metadata
/// when a flag stat'ed it, its identity (`ino`/`dev`: the target's for a
/// followed link, else its own; `-l`'s cycle set and `-x`), and in the
/// built tree the error that stopped its descent. A symlink's target, a
/// built directory's children, `--info`'s lines and `--condense`'s
/// joined name live in the walk's side tables, `lnk`, `child`, `info`
/// and `cname` their indices there (-1: none), so an entry with none of
/// them carries no empty list (two allocations an entry, measured:
/// docs/MAP.md); `cond` counts the singleton directories `--condense`
/// folded into it.
pub struct Ent {
    nm: List[byte],
    kind: int,
    ltype: int,
    lmode: int,
    flags: int,
    lnk: int,
    st: Meta,
    has_st: bool,
    ino: int,
    dev: int,
    child: int,
    err: str,
    info: int,
    cond: int,
    cname: int,
}

/// The built tree's arena (C aspen's per-root arena, `src/arena.c`):
/// the entries, and the side tables their indices name: link targets,
/// children lists, `--info` lines, `--condense`'s joined names (each a
/// row: byte 0 a placeholder, the name after it).
pub struct Arena {
    ents: List[Ent],
    lnks: List[List[byte]],
    kids: List[List[int]],
    infos: List[List[List[byte]]],
    cnames: List[List[byte]],
}

/// An empty arena.
pub fn arena() -> Arena {
    Arena {
        ents: List[Ent](),
        lnks: List[List[byte]](),
        kids: List[List[int]](),
        infos: List[List[List[byte]]](),
        cnames: List[List[byte]](),
    }
}

/// Metadata nobody read (`has_st` false beside it).
pub fn no_meta() -> Meta {
    Meta { kind: 2, mode: 0, size: 0, mtime: 0, ctime: 0, uid: 0, gid: 0, ino: 0, dev: 0 }
}

/// A `Meta` from the twenty words `fs_lstat`/`fs_stat` answer
/// (`std.fs.Info`'s table: 0 kind, 1 size, 4 mode, 6 uid, 7 gid, 9 dev,
/// 10 ino, 14 mtime s, 16 ctime s).
pub fn meta_of(w: List[int]) -> Meta {
    Meta {
        kind: w[0],
        mode: w[4],
        size: w[1],
        mtime: w[14],
        ctime: w[16],
        uid: w[6],
        gid: w[7],
        ino: w[10],
        dev: w[9],
    }
}

/// A fresh entry of type `kind` named by the row `nm`.
pub fn new_ent(take nm: List[byte], kind: int) -> Ent {
    Ent {
        nm: nm,
        kind: kind,
        ltype: -1,
        lmode: 0,
        flags: 0,
        lnk: -1,
        st: no_meta(),
        has_st: false,
        ino: 0,
        dev: 0,
        child: -1,
        err: "",
        info: -1,
        cond: 0,
        cname: -1,
    }
}

/// A symlink to a directory counts and sorts as a directory (tree, all
/// modes; `src/traverse.c:732`).
pub fn dir_like(e: Ent) -> bool {
    e.kind == 1 || e.kind == 3 && e.ltype == 1
}

/// tree's long type name (`src/entry.c:5`), for `-J`.
pub fn type_name(kind: int) -> str {
    match kind {
        0 => "file",
        1 => "directory",
        3 => "link",
        4 => "fifo",
        5 => "socket",
        6 => "char",
        7 => "block",
        _ => "unknown",
    }
}
