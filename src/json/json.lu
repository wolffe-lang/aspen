//! json — `-J` (C aspen `src/render/json.c`, "faithful to tree's
//! json.c"): the whole tree built first, then emitted as a nested array,
//! a report object last; `-i` drops the indentation and the newlines,
//! `--compress` narrows the indent unit. DEVIATION D2 is carried: after
//! an error no later entry gets an empty contents array
//! (`src/render/json.c:209`).

use ent
use info
use opts
use out

/// The JSON renderer's state: its writer, the `-f` path stack and the
/// columns.
pub struct Json {
    o: out.Out,
    fp: List[byte],
    cols: info.Cols,
}

/// A renderer writing to descriptor `fd`.
pub fn new(fd: int, take cols: info.Cols) -> Json {
    Json { o: out.to_fd(fd), fp: List[byte](), cols: cols }
}

/// RFC 8259 escaping, tree's json_encode (`src/render/json.c:42`): the
/// two-character escapes for backspace, tab, newline, form feed, carriage
/// return and NUL, a six-character unicode escape for the other controls,
/// a backslash before a quote or a backslash; every other byte, UTF-8
/// included, as is.
pub fn enc(mut o: out.Out, s: List[byte], from: int, to: int) {
    let hex = "0123456789abcdef"
    var i = from
    while i < to {
        let c = s[i] as int
        if c < 32 {
            if c == 8 {
                out.s(mut o, "\\b")
            } else if c == 9 {
                out.s(mut o, "\\t")
            } else if c == 10 {
                out.s(mut o, "\\n")
            } else if c == 12 {
                out.s(mut o, "\\f")
            } else if c == 13 {
                out.s(mut o, "\\r")
            } else if c == 0 {
                out.s(mut o, "\\0")
            } else {
                out.s(mut o, "\\u00")
                out.s(mut o, hex[c / 16..c / 16 + 1])
                out.s(mut o, hex[c % 16..c % 16 + 1])
            }
        } else if c == 34 || c == 92 {
            out.c(mut o, 92)
            out.c(mut o, c)
        } else {
            (mut o.buf).push(s[i])
        }
        i += 1
    }
}

fn bs(s: str) -> List[byte] {
    var b = List[byte]()
    for x in s.bytes() {
        (mut b).push(x)
    }
    b
}

fn enc_str(mut o: out.Out, s: str) {
    let b = bs(s)
    enc(mut o, b, 0, b.len)
}

fn nl(mut j: Json, o: opts.Opts) {
    if !o.noindent {
        out.c(mut j.o, 10)
    }
}

/// The indent unit (`junit`): four spaces, narrowed by `--compress`.
fn unit(o: opts.Opts) -> str {
    let spaces = ["    ", "   ", "  ", " ", ""]
    spaces[o.compress_indent + (if o.remove_space then 1 else 0)]
}

fn indent(mut j: Json, o: opts.Opts, level: int) {
    if o.noindent {
        return
    }
    let u = unit(o)
    var i = 0
    while i <= level {
        out.s(mut j.o, u)
        i += 1
    }
}

fn oct4(n: int) -> str {
    let d3 = n / 512 % 8
    let d2 = n / 64 % 8
    let d1 = n / 8 % 8
    let d0 = n % 8
    "{d3}{d2}{d1}{d0}"
}

/// The metadata keys (`src/render/json.c:78`).
fn fill(mut j: Json, o: opts.Opts, st: ent.Meta, ids: ent.Ids) {
    if o.inodeflag {
        out.s(mut j.o, ",\"inode\":{ids.ino}")
    }
    if o.devflag {
        out.s(mut j.o, ",\"dev\":{info.int32(ids.dev)}")
    }
    if o.permflag {
        let p = info.prot(st.kind, st.mode)
        out.s(mut j.o, ",\"mode\":\"{oct4(st.mode)}\",\"prot\":\"{p}\"")
    }
    if o.userflag {
        let u = info.user_name(mut j.cols, ids.uid)
        out.s(mut j.o, ",\"user\":\"{u}\"")
    }
    if o.groupflag {
        let g = info.group_name(mut j.cols, ids.gid)
        out.s(mut j.o, ",\"group\":\"{g}\"")
    }
    if o.sizeflag {
        if o.humanflag || o.siflag {
            let h = info.psize(o.humanflag, o.siflag, st.size).trim_start()
            out.s(mut j.o, ",\"size\":\"{h}\"")
        } else {
            out.s(mut j.o, ",\"size\":{st.size}")
        }
    }
    if o.dateflag {
        out.s(mut j.o, ",\"time\":\"")
        let d = info.date_bytes(o, j.cols, if o.ctimeflag then st.ctime else st.mtime)
        out.bytes(mut j.o, d, 0, d.len)
        out.c(mut j.o, 34)
    }
}

/// The document's opening bracket.
pub fn begin(mut j: Json, o: opts.Opts) {
    out.c(mut j.o, 91)
    nl(mut j, o)
}

fn head(mut j: Json, o: opts.Opts, a: ent.Arena, e: ent.Ent) {
    out.s(mut j.o, "{{\"type\":\"")
    out.s(mut j.o, ent.type_name(e.kind))
    out.s(mut j.o, "\",\"name\":\"")
    if o.fullpath {
        enc(mut j.o, j.fp, 0, j.fp.len)
    } else if ent.cname_of(a, e) >= 0 {
        let cn = ent.cname_of(a, e)
        enc(mut j.o, a.cnames[cn], 1, a.cnames[cn].len)
    } else {
        enc(mut j.o, e.nm, 1, e.nm.len)
    }
    out.c(mut j.o, 34)
    let inf = ent.info_of(a, e)
    if inf >= 0 {
        out.s(mut j.o, ",\"info\":\"")
        let lines = copy a.infos[inf]
        var i = 0
        while i < lines.len {
            enc(mut j.o, lines[i], 0, lines[i].len)
            if i + 1 < lines.len {
                out.s(mut j.o, "\\n")
            }
            i += 1
        }
        out.c(mut j.o, 34)
    }
    if e.lnk >= 0 {
        out.s(mut j.o, ",\"target\":\"")
        enc(mut j.o, a.lnks[e.lnk], 0, a.lnks[e.lnk].len)
        out.c(mut j.o, 34)
    }
    if e.has_st {
        fill(mut j, o, e.st, ent.ids(a, e))
    }
}

fn close(mut j: Json, o: opts.Opts, last: bool) {
    if !last {
        out.c(mut j.o, 44)
    }
    nl(mut j, o)
}

/// One level of the built tree (`src/render/json.c:151`), in the arena's
/// display order; answers the directories and files it counted.
fn level(mut j: Json, o: opts.Opts, a: ent.Arena, arr: List[int], depth: int) -> (int, int) {
    var dirs = 0
    var files = 0
    let n = arr.len
    var i = 0
    while i < n {
        let k = arr[i]
        let e = copy a.ents[k]
        let last = i + 1 == n
        let dl = ent.dir_like(e)
        if dl {
            dirs += 1 + ent.cond_of(a, e)
        } else {
            files += 1
        }
        let saved = j.fp.len
        if o.fullpath {
            (mut j.fp).push(47 as byte)
            let cn = ent.cname_of(a, e)
            let nm = if cn >= 0 then copy a.cnames[cn] else copy e.nm
            var x = 1
            while x < nm.len {
                (mut j.fp).push(nm[x])
                x += 1
            }
        }
        indent(mut j, o, depth)
        head(mut j, o, a, e)
        let kids = e.child >= 0 && a.kids[e.child].len > 0
        let direrr = dl && e.err.len > 0 && !kids
        if kids {
            out.s(mut j.o, ",\"contents\":[")
            nl(mut j, o)
            let (d, f) = level(mut j, o, a, a.kids[e.child], depth + 1)
            dirs += d
            files += f
            indent(mut j, o, depth)
            out.s(mut j.o, "]}}")
            close(mut j, o, last)
        } else if direrr {
            // tree closes an unreadable or over-limit directory's error
            // with one fixed unit; a "recursive, not followed" link with
            // the entry's own indent (`src/render/json.c:196`)
            out.s(mut j.o, ",\"contents\":[{{\"error\": \"")
            out.s(mut j.o, e.err)
            out.s(mut j.o, "\"}}")
            if e.flags & ent.f_recursive() != 0 {
                indent(mut j, o, depth)
            } else if !o.noindent {
                out.s(mut j.o, unit(o))
            }
            out.s(mut j.o, "]}}")
            close(mut j, o, last)
        } else {
            out.c(mut j.o, 125)
            close(mut j, o, last)
        }
        while j.fp.len > saved {
            let _ = (mut j.fp).pop() else 0 as byte
        }
        out.maybe(mut j.o)
        i += 1
    }
    (dirs, files)
}

/// One root (`src/render/json.c:269`): an unopened one typed by its
/// `lstat` ("unknown" when there is none) with the error as its contents;
/// an opened one typed by its `lstat` too (a symlink to a directory is
/// "link", as tree has it; docs/MAP.md §5), its contents only when it has
/// entries, or the `--filelimit` error. tree shows a root's inode and
/// device as 0. Answers the directories and files counted.
pub fn tree(
    mut j: Json,
    o: opts.Opts,
    root: str,
    st0: ent.Meta,
    ids0: ent.Ids,
    has: bool,
    opened: bool,
    limit: str,
    a: ent.Arena,
    top: List[int],
    last: bool,
) -> (int, int) {
    let st = st0
    // tree shows a root's inode and device as 0, its owners as they are
    var z = ids0
    z.ino = 0
    z.dev = 0
    indent(mut j, o, 0)
    if !opened {
        let ft = if has then ent.type_name(st.kind) else "unknown"
        out.s(mut j.o, "{{\"type\":\"")
        out.s(mut j.o, ft)
        out.s(mut j.o, "\",\"name\":\"")
        enc_str(mut j.o, root)
        out.c(mut j.o, 34)
        if has {
            fill(mut j, o, st, z)
        }
        out.s(mut j.o, ",\"contents\":[{{\"error\": \"error opening dir\"}}")
        nl(mut j, o)
        indent(mut j, o, 0)
        out.s(mut j.o, "]}}")
        close(mut j, o, last)
        return (0, 0)
    }
    let rtype = if st.kind == 1 || st.kind == 2 then "directory" else ent.type_name(st.kind)
    out.s(mut j.o, "{{\"type\":\"")
    out.s(mut j.o, rtype)
    out.s(mut j.o, "\",\"name\":\"")
    enc_str(mut j.o, root)
    out.c(mut j.o, 34)
    if has {
        fill(mut j, o, st, z)
    }
    if limit.len > 0 {
        out.s(mut j.o, ",\"contents\":[{{\"error\": \"")
        enc_str(mut j.o, limit)
        out.s(mut j.o, "\"}}")
        nl(mut j, o)
        indent(mut j, o, 0)
        out.s(mut j.o, "]}}")
        close(mut j, o, last)
        return (1, 0)
    }
    var dirs = 0
    var files = 0
    if top.len > 0 {
        dirs += 1
        if o.fullpath {
            j.fp = bs(root)
        }
        out.s(mut j.o, ",\"contents\":[")
        nl(mut j, o)
        let (d, f) = level(mut j, o, a, top, 1)
        dirs += d
        files += f
        indent(mut j, o, 0)
        out.s(mut j.o, "]}}")
    } else {
        out.c(mut j.o, 125)
    }
    close(mut j, o, last)
    out.maybe(mut j.o)
    (dirs, files)
}

/// The report object (`src/render/json.c:242`).
pub fn report(mut j: Json, o: opts.Opts, dirs: int, files: int, size: int) {
    out.c(mut j.o, 44)
    indent(mut j, o, 0)
    out.s(mut j.o, "{{\"type\":\"report\"")
    if o.duflag {
        out.s(mut j.o, ",\"size\":{size}")
    }
    out.s(mut j.o, ",\"directories\":{dirs}")
    if !o.dirsonly {
        out.s(mut j.o, ",\"files\":{files}")
    }
    out.c(mut j.o, 125)
}

/// The document's close, and the flush.
pub fn end(mut j: Json, o: opts.Opts) {
    nl(mut j, o)
    out.s(mut j.o, "]\n")
    out.flush(mut j.o)
}
