/// `--sort`'s names, any case (`src/options.c:227`); -1 for none.
fn sort_of(name: str) -> int {
    let n = name.lower()
    if n == "name" {
        return 0
    }
    if n == "version" {
        return 1
    }
    if n == "size" {
        return 2
    }
    if n == "mtime" {
        return 3
    }
    if n == "ctime" {
        return 4
    }
    if n == "none" {
        return 5
    }
    -1
}

/// `--threads`' strict reading (`src/options.c:297`): decimal digits
/// with an optional sign, 0..65535, nothing after; -1 when it is not.
pub fn threads_value(v: str) -> int {
    let n = v.len
    if n == 0 {
        return -1
    }
    var i = 0
    var neg = false
    if v.bytes()[0] as int == 43 || v.bytes()[0] as int == 45 {
        neg = v.bytes()[0] as int == 45
        i = 1
    }
    if i >= n {
        return -1
    }
    var t: int = 0
    while i < n {
        let c = v.bytes()[i] as int
        if c < 48 || c > 57 {
            return -1
        }
        if t <= 65535 {
            t = t * 10 + (c - 48)
        }
        i += 1
    }
    if neg && t != 0 || t > 65535 {
        return -1
    }
    t
}

fn tog(cur: bool, toggle: bool) -> bool {
    if toggle then !cur else true
}

/// Parse `args` (argv without the program name) as tree does
/// (`src/options.c:323`); `macos` is `is_macos()`, asked by the caller so
/// that the parser touches no file (and runs on lupin).
pub fn parse(args: List[str], macos: bool) -> Parsed {
    var o = defaults()
    var roots = List[str]()
    var optf = true
    var toggle = false
    var i = 0
    let argc = args.len
    while i < argc {
        let a = args[i]
        let ab = a.bytes()
        if optf && a.len > 1 && ab[0] as int == 45 {
            if ab[1] as int == 45 {
                if a == "--" {
                    optf = false
                    i += 1
                    continue
                }
                if a == "--help" {
                    return stopped(o, 0, synopsis(macos) + help_body(macos), "")
                }
                if a == "--version" {
                    return stopped(o, 0, "aspen v{version()}\n", "")
                }
                if a == "--inodes" {
                    o.inodeflag = tog(o.inodeflag, toggle)
                } else if a == "--device" {
                    o.devflag = tog(o.devflag, toggle)
                } else if a == "--noreport" {
                    o.noreport = tog(o.noreport, toggle)
                } else if a == "--nolinks" {
                    o.nolinks = tog(o.nolinks, toggle)
                } else if a == "--dirsfirst" {
                    o.dirsfirst = true
                    o.filesfirst = false
                } else if a == "--filesfirst" {
                    o.filesfirst = true
                    o.dirsfirst = false
                } else if a == "--si" {
                    o.siflag = true
                    o.humanflag = true
                    o.sizeflag = true
                } else if a == "--du" {
                    o.duflag = true
                    o.sizeflag = true
                } else if a == "--prune" {
                    o.prune = tog(o.prune, toggle)
                } else if a == "--ignore-case" {
                    o.ignorecase = tog(o.ignorecase, toggle)
                } else if a == "--matchdirs" {
                    o.matchdirs = tog(o.matchdirs, toggle)
                } else if a == "--condense" {
                    o.condense = tog(o.condense, toggle)
                } else if a == "--metafirst" {
                    o.metafirst = tog(o.metafirst, toggle)
                } else if a == "--gitignore" {
                    o.gitignore = tog(o.gitignore, toggle)
                } else if a == "--info" {
                    o.showinfo = tog(o.showinfo, toggle)
                } else if a == "--fromfile" {
                    o.fromfile = true
                } else if a == "--fromtabfile" {
                    o.fromtabfile = true
                } else if a == "--fflinks" {
                    o.fflinks = tog(o.fflinks, toggle)
                } else if a == "--hyperlink" {
                    o.hyperlink = tog(o.hyperlink, toggle)
                } else if a == "--opt-toggle" {
                    toggle = !toggle
                } else if a == "--acl" || a == "--selinux" {
                    return refuse(
                        o,
                        a,
                        "tree's option: it reads extended attributes, which wolf has no call for",
                    )
                } else {
                    let r = parse_valued(mut o, a, i, args)
                    if r.fail >= 0 {
                        return Parsed {
                            o: copy o,
                            roots: List[str](),
                            stop: r.fail,
                            out: r.out,
                            err: r.err,
                        }
                    }
                    if !r.matched {
                        return stopped(
                            o,
                            1,
                            "",
                            "aspen: Invalid argument `{a}'.\n" + synopsis(macos),
                        )
                    }
                    i = r.next
                }
                i += 1
                continue
            }
            var j = 1
            let n = a.len
            while j < n {
                let ch = ab[j] as int
                if ch == 97 {
                    o.all = tog(o.all, toggle)
                } else if ch == 100 {
                    o.dirsonly = tog(o.dirsonly, toggle)
                } else if ch == 102 {
                    o.fullpath = tog(o.fullpath, toggle)
                } else if ch == 105 {
                    o.noindent = tog(o.noindent, toggle)
                } else if ch == 120 {
                    o.xdev = tog(o.xdev, toggle)
                } else if ch == 108 {
                    o.follow = tog(o.follow, toggle)
                } else if ch == 82 {
                    o.rerun = tog(o.rerun, toggle)
                } else if ch == 70 {
                    o.classify = tog(o.classify, toggle)
                } else if ch == 115 {
                    o.sizeflag = tog(o.sizeflag, toggle)
                } else if ch == 104 {
                    o.humanflag = tog(o.humanflag, toggle)
                    o.sizeflag = o.humanflag
                } else if ch == 117 {
                    o.userflag = tog(o.userflag, toggle)
                } else if ch == 103 {
                    o.groupflag = tog(o.groupflag, toggle)
                } else if ch == 112 {
                    o.permflag = tog(o.permflag, toggle)
                } else if ch == 68 {
                    o.dateflag = tog(o.dateflag, toggle)
                } else if ch == 113 {
                    o.qmark = tog(o.qmark, toggle)
                } else if ch == 78 {
                    o.noprint = tog(o.noprint, toggle)
                } else if ch == 81 {
                    o.quote = tog(o.quote, toggle)
                } else if ch == 67 {
                    o.forcecolor = tog(o.forcecolor, toggle)
                } else if ch == 110 {
                    o.nocolor = tog(o.nocolor, toggle)
                } else if ch == 65 {
                    o.ansilines = tog(o.ansilines, toggle)
                } else if ch == 83 {
                    o.charset = "IBM437"
                    o.has_charset = true
                } else if ch == 116 {
                    o.sort = sort_mtime()
                } else if ch == 99 {
                    o.sort = sort_ctime()
                    o.ctimeflag = true
                } else if ch == 114 {
                    o.reverse = tog(o.reverse, toggle)
                } else if ch == 118 {
                    o.sort = sort_version()
                } else if ch == 85 {
                    o.sort = sort_none()
                } else if ch == 88 {
                    o.format = out_xml()
                } else if ch == 74 {
                    o.format = out_json()
                } else if ch == 72 || ch == 84 || ch == 111 || ch == 80 || ch == 73 {
                    // -H/-T/-o/-P/-I take the glued remainder or the next
                    // word (DEVIATION D5, `src/options.c:166`)
                    var v = ""
                    if j + 1 < n {
                        v = a[j + 1..]
                    } else {
                        if i + 1 >= argc {
                            let what = "-" + a[j..j + 1]
                            return stopped(o, 1, "", "aspen: Missing argument to {what} option.\n")
                        }
                        i += 1
                        v = args[i]
                    }
                    j = n - 1
                    if ch == 72 {
                        o.format = out_html()
                        if v.starts_with("-") {
                            o.htmloffset = true
                            v = v[1..]
                        }
                        o.host = v
                        o.has_host = true
                    } else if ch == 84 {
                        o.title = v
                        o.has_title = true
                    } else if ch == 80 {
                        (mut o.patterns).push(bytes_of(v))
                    } else if ch == 73 {
                        (mut o.ipatterns).push(bytes_of(v))
                    } else {
                        o.outfile = v
                        o.has_outfile = true
                    }
                } else if ch == 76 {
                    var s = ""
                    if j + 1 < n && ab[j + 1] as int >= 48 && ab[j + 1] as int <= 57 {
                        var k = j + 1
                        while k < n && ab[k] as int >= 48 && ab[k] as int <= 57 && k - j <= 31 {
                            k += 1
                        }
                        s = a[j + 1..k]
                        j = k - 1
                    } else {
                        if i + 1 >= argc {
                            return stopped(o, 1, "", "aspen: Missing argument to -L option.\n")
                        }
                        i += 1
                        s = args[i]
                        j = n - 1
                    }
                    let lvl = level_int(s) - 1
                    if lvl < 0 {
                        return stopped(o, 1, "", "aspen: Invalid level, must be greater than 0.\n")
                    }
                    o.level = lvl + 1
                } else {
                    let c1 = a.get(j..j + 1) else "?"
                    return stopped(o, 1, "", "aspen: Invalid argument -`{c1}'.\n" + synopsis(macos))
                }
                j += 1
            }
        } else {
            (mut roots).push(a)
        }
        i += 1
    }
    Parsed { o: o, roots: roots, stop: -1, out: "", err: "" }
}

/// The answer of the value-taking long options.
struct Valued {
    matched: bool,
    next: int,
    fail: int,
    out: str,
    err: str,
}

fn vfail(lv: LongVal) -> Valued {
    Valued { matched: true, next: lv.next, fail: lv.fail, out: "", err: lv.err }
}

/// The long options that take a value (`src/options.c:284`), in C
/// aspen's order.
fn parse_valued(mut o: Opts, a: str, i: int, args: List[str]) -> Valued {
    let names = [
        "--compress",
        "--charset",
        "--filelimit",
        "--threads",
        "--timefmt",
        "--sort",
        "--gitfile",
        "--infofile",
        "--hintro",
        "--houtro",
        "--scheme",
        "--authority",
    ]
    for pfx in names {
        let lv = long_val(a, pfx, i, args)
        if !lv.matched {
            continue
        }
        if lv.fail >= 0 {
            return vfail(lv)
        }
        let v = lv.value
        if pfx == "--compress" {
            // tree's clamp: negative drops the space after a connector, past
            // 3 is -i, then one less indexes the three widths
            var ci = atoi32(v)
            o.remove_space = ci < 0
            if ci < 0 {
                ci = -ci
            }
            if ci > 3 {
                ci = 0
                o.noindent = true
            }
            if ci > 0 {
                ci -= 1
            }
            o.compress_indent = ci
        } else if pfx == "--charset" {
            o.charset = v
            o.has_charset = true
        } else if pfx == "--filelimit" {
            o.filelimit = atol(v)
        } else if pfx == "--threads" {
            let t = threads_value(v)
            if t < 0 {
                return Valued {
                    matched: true,
                    next: lv.next,
                    fail: 1,
                    out: "",
                    err: "aspen: Invalid --threads value '{v}' (expected 0..65535).\n",
                }
            }
            o.threads = t
        } else if pfx == "--timefmt" {
            o.timefmt = v
            o.has_timefmt = true
            o.dateflag = true
        } else if pfx == "--sort" {
            let k = sort_of(v)
            if k < 0 {
                // tree splits the streams (`src/options.c:228`): the prefix
                // without a newline on stderr, the list on stdout
                return Valued {
                    matched: true,
                    next: lv.next,
                    fail: 1,
                    out: "name,version,size,mtime,ctime,none\n",
                    err: "aspen: Sort type '{v}' not valid, should be one of: ",
                }
            }
            o.sort = k
        } else if pfx == "--gitfile" || pfx == "--infofile" {
            // tree loads each file as it parses its option, and stops at
            // the first it cannot (measured: before a later bad flag, with
            // no output, status 1); every one is kept, where C aspen keeps
            // the last (`src/options.c:313`). The parser reads no file:
            // `loads` lists them in order for the caller (`load_error`)
            (mut o.loads).push(v)
            (mut o.load_git).push(pfx == "--gitfile")
            if pfx == "--gitfile" {
                o.gitignore = true
                (mut o.gitfiles).push(v)
            } else {
                o.showinfo = true
                (mut o.infofiles).push(v)
            }
        } else if pfx == "--hintro" {
            o.hintro = v
            o.has_hintro = true
        } else if pfx == "--houtro" {
            o.houtro = v
            o.has_houtro = true
        } else if pfx == "--scheme" {
            o.scheme = v
            o.has_scheme = true
        } else {
            o.authority = v
            o.has_authority = true
        }
        return Valued { matched: true, next: lv.next, fail: -1, out: "", err: "" }
    }
    Valued { matched: false, next: i, fail: -1, out: "", err: "" }
}
