//! opts — the option state and tree's command line (C aspen
//! `src/options.c`, `src/options.h`).
//!
//! The parser recognizes tree 2.3.2's whole flag surface (`src/options.h:5`)
//! and C aspen's own `--threads`, with `--opt-toggle`'s flips and tree's
//! wording and exit 1 for every usage error (`src/options.c:142`). Two of
//! tree's linux options, `--acl` and `--selinux`, need the file's extended
//! attributes, which wolf cannot read: they are refused BY NAME with exit
//! 2 (`refuse`), until a ruling says otherwise
//! (notes/ap01-the-second-light.md §9). C aspen's `--asp-diff` and test
//! hook `--asp-debug-walk` are taken out before the parse (`src/main.c:99`).

/// The sort keys (`src/options.h:14`).
pub fn sort_name() -> int {
    0
}

/// `-v`, `--sort=version`.
pub fn sort_version() -> int {
    1
}

/// `--sort=size`: larger first.
pub fn sort_size() -> int {
    2
}

/// `-t`, `--sort=mtime`.
pub fn sort_mtime() -> int {
    3
}

/// `-c`, `--sort=ctime`.
pub fn sort_ctime() -> int {
    4
}

/// `-U`, `--sort=none`: the host's order, and no `--dirsfirst`.
pub fn sort_none() -> int {
    5
}

/// The output formats (`src/options.h:23`).
pub fn out_unix() -> int {
    0
}

/// `-X`.
pub fn out_xml() -> int {
    1
}

/// `-J`.
pub fn out_json() -> int {
    2
}

/// `-H baseHREF`.
pub fn out_html() -> int {
    3
}

/// The parsed options (`src/options.h:25`). A string option that may be
/// absent carries a `has_` flag beside it (the C's NULL).
pub struct Opts {
    all: bool,
    dirsonly: bool,
    fullpath: bool,
    noindent: bool,
    xdev: bool,
    follow: bool,
    classify: bool,
    rerun: bool,
    level: int,
    sizeflag: bool,
    humanflag: bool,
    siflag: bool,
    duflag: bool,
    permflag: bool,
    userflag: bool,
    groupflag: bool,
    dateflag: bool,
    ctimeflag: bool,
    inodeflag: bool,
    devflag: bool,
    timefmt: str,
    has_timefmt: bool,
    ignorecase: bool,
    matchdirs: bool,
    quote: bool,
    noprint: bool,
    qmark: bool,
    patterns: List[List[byte]],
    ipatterns: List[List[byte]],
    gitignore: bool,
    gitfiles: List[str],
    loads: List[str],
    load_git: List[bool],
    prune: bool,
    showinfo: bool,
    infofiles: List[str],
    filelimit: int,
    metafirst: bool,
    condense: bool,
    compress_indent: int,
    remove_space: bool,
    reverse: bool,
    dirsfirst: bool,
    filesfirst: bool,
    sort: int,
    charset: str,
    has_charset: bool,
    ansilines: bool,
    forcecolor: bool,
    nocolor: bool,
    noreport: bool,
    hyperlink: bool,
    scheme: str,
    has_scheme: bool,
    authority: str,
    has_authority: bool,
    format: int,
    host: str,
    has_host: bool,
    title: str,
    has_title: bool,
    hintro: str,
    has_hintro: bool,
    houtro: str,
    has_houtro: bool,
    outfile: str,
    has_outfile: bool,
    nolinks: bool,
    htmloffset: bool,
    fromfile: bool,
    fromtabfile: bool,
    fflinks: bool,
    threads: int,
    colorize: bool,
}

/// What the command line asked for: the options and roots, or (`stop` >=
/// 0) an exit status with what to print first.
pub struct Parsed {
    o: Opts,
    roots: List[str],
    stop: int,
    out: str,
    err: str,
}

/// Every option off, the level unlimited (`src/options.c:11`).
pub fn defaults() -> Opts {
    Opts {
        all: false,
        dirsonly: false,
        fullpath: false,
        noindent: false,
        xdev: false,
        follow: false,
        classify: false,
