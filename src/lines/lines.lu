//! lines — the indentation line sets (C aspen `src/charset.c`, whose
//! names and connector forms are tree 2.3.2's table, `src/charset.c:7`).
//!
//! Each connector carries its three widths, widest first, indexed by
//! `--compress`'s level (`src/charset.h:5`), and each set its five
//! `--info` comment glyphs. They are BYTES: most of the table's sets are
//! not UTF-8 (CP437's `\263`, Shift_JIS, …) and a wolf `str` cannot hold
//! them. Selection is `src/charset.c:143`'s: `-A` is ANSI; else the
//! charset `name` answers (`--charset`/`-S`, `$TREE_CHARSET`, `UTF-8` in
//! a UTF-8 locale), matched without regard to case against the table's
//! names; else the ASCII fallback.

use opts

/// One line set: the continuing-ancestor glyph, the branch and the
/// corner, three widths each, and the comment glyphs.
pub struct Lines {
    vert: List[List[byte]],
    vleft: List[List[byte]],
    corner: List[List[byte]],
    ctop: List[byte],
    cbot: List[byte],
    cmid: List[byte],
    cext: List[byte],
    csingle: List[byte],
}

fn b(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn bs(s: str) -> List[byte] {
    var out = List[byte]()
    for x in s.bytes() {
        (mut out).push(x)
    }
    out
}

/// `xs` and its two narrower forms: the whole, all but the last `cut`
/// bytes, all but the last `2 * cut` (the table's connectors narrow by
/// one glyph a step, `src/charset.c:61`).
fn three(xs: List[int], cut: int) -> List[List[byte]] {
    var out = List[List[byte]]()
    var k = 0
    while k < 3 {
        var r = List[byte]()
        let n = xs.len - k * cut
        var i = 0
        while i < n {
            (mut r).push(xs[i] as byte)
            i += 1
        }
        (mut out).push(r)
        k += 1
    }
    out
}

/// The three forms given whole, for the sets whose narrowing is not a
/// suffix cut (an escape sequence closes them).
fn forms(a: List[int], m: List[int], z: List[int]) -> List[List[byte]] {
    var out = List[List[byte]]()
    (mut out).push(b(a))
    (mut out).push(b(m))
    (mut out).push(b(z))
    out
}

fn plain_comments(v: List[List[byte]], l: List[List[byte]], c: List[List[byte]]) -> Lines {
    Lines {
        vert: copy v,
        vleft: copy l,
        corner: copy c,
        ctop: bs(" ["),
        cbot: bs(" ["),
        cmid: bs(" ["),
        cext: bs(" ["),
        csingle: bs(" ["),
    }
}

/// LD_ASCII_BT (`src/charset.c:63`): `"|  "`, `"|--"`, `` "`--" ``; the
/// fallback, VISCII and the windows sets.
pub fn ascii() -> Lines {
    plain_comments(three([124, 32, 32], 1), ascii_branch(), three([96, 45, 45], 1))
}

/// `"|--"`, `"|-"`, `"+"`: the ASCII branch's narrowest form is a plus.
fn ascii_branch() -> List[List[byte]] {
    forms([124, 45, 45], [124, 45], [43])
}

fn ascii_plus() -> Lines {
    // LD_ASCII_PLUS (`src/charset.c:61`): the corner is "&middot;--"
    var c = List[List[byte]]()
    (mut c).push(bs("&middot;--"))
    (mut c).push(bs("&middot;-"))
    (mut c).push(bs("&middot;"))
    plain_comments(three([124, 32, 32], 1), ascii_branch(), c)
}

/// The VT100 alternate-character-set hack (`-A`, `src/charset.c:73`).
pub fn ansi() -> Lines {
    plain_comments(
        forms(
            [27, 40, 48, 120, 32, 32, 27, 40, 66],
            [27, 40, 48, 120, 32, 27, 40, 66],
            [27, 40, 48, 120, 27, 40, 66],
        ),
        forms(
            [27, 40, 48, 116, 113, 113, 27, 40, 66],
            [27, 40, 48, 116, 113, 27, 40, 66],
            [27, 40, 48, 116, 27, 40, 66],
        ),
        forms(
            [27, 40, 48, 109, 113, 113, 27, 40, 66],
            [27, 40, 48, 109, 113, 27, 40, 66],
            [27, 40, 48, 109, 27, 40, 66],
        ),
    )
}

/// `│` and two NO-BREAK SPACEs, `├──`, `└──` (`src/charset.c:96`), and
/// the brace glyphs for `--info`'s comment lines.
pub fn utf8() -> Lines {
    Lines {
        vert: three([226, 148, 130, 194, 160, 194, 160], 2),
        vleft: three([226, 148, 156, 226, 148, 128, 226, 148, 128], 3),
        corner: three([226, 148, 148, 226, 148, 128, 226, 148, 128], 3),
        ctop: b([32, 226, 142, 167]),
        cbot: b([32, 226, 142, 169]),
        cmid: b([32, 226, 142, 168]),
        cext: b([32, 226, 142, 170]),
        csingle: b([32, 123]),
    }
}

fn ibm() -> Lines {
    plain_comments(three([179, 32, 32], 1), three([195, 196, 196], 1), three([192, 196, 196], 1))
}

/// A two-byte-glyph set: the vertical glyph and two spaces, then the
/// branch and the corner, each a two-byte glyph and two of the
/// horizontal one.
fn wide(v: List[int], l: List[int], c: List[int], h: List[int]) -> Lines {
    let vv = [v[0], v[1], 32, 32]
    let ll = [l[0], l[1], h[0], h[1], h[0], h[1]]
    let cc = [c[0], c[1], h[0], h[1], h[0], h[1]]
    var vf = List[List[byte]]()
    (mut vf).push(b(vv))
    (mut vf).push(b([v[0], v[1], 32]))
    (mut vf).push(b([v[0], v[1]]))
    plain_comments(vf, three(ll, 2), three(cc, 2))
}

fn iso2022jp() -> Lines {
    plain_comments(
        forms(
            [27, 36, 66, 40, 34, 27, 40, 66, 32, 32],
            [27, 36, 66, 40, 34, 27, 40, 66, 32],
            [27, 36, 66, 40, 34, 27, 40, 66],
        ),
        forms(
            [27, 36, 66, 40, 39, 27, 36, 66, 40, 33, 27, 36, 66, 40, 33, 27, 40, 66],
            [27, 36, 66, 40, 39, 27, 36, 66, 40, 33, 27, 40, 66],
            [27, 36, 66, 40, 39, 27, 40, 66],
        ),
        forms(
            [27, 36, 66, 40, 38, 27, 36, 66, 40, 33, 27, 36, 66, 40, 33, 27, 40, 66],
            [27, 36, 66, 40, 38, 27, 36, 66, 40, 33, 27, 40, 66],
            [27, 36, 66, 40, 38, 27, 40, 66],
        ),
    )
}

fn koi8() -> Lines {
    plain_comments(three([129, 32, 32], 1), three([134, 128, 128], 1), three([132, 128, 128], 1))
}

fn any_is(name: str, names: List[str]) -> bool {
    for n in names {
        if n.lower() == name {
            return true
        }
    }
    false
}

/// The set for charset `cs` (any case), or the ASCII fallback.
pub fn for_charset(cs: str) -> Lines {
    let n = cs.lower()
    if n == "ansi" {
        return ansi()
    }
    let names = opts.charset_names()
    // the table's rows by their index in `charset_names`
    // (`src/charset.c:69`): ANSI 0, latin1/3 1..14, ISO 7/8/9 15..35,
    // Shift_JIS 36..38, EUC-JP 39..41, EUC-KR 42..43, ISO-2022-JP
    // 44..47, IBM PC 48..71, IBM PS/2 72..79, IBM greek 80..84, GB2312
    // 85..86, UTF-8 87..88, Big5 89..90, VISCII 91..92, KOI8 93..95,
    // windows 96..107
    var row = -1
    var i = 0
    while i < names.len {
        if names[i].lower() == n {
            row = i
            break
        }
        i += 1
    }
    if row < 0 {
        return ascii()
    }
    if row <= 35 {
        return ascii_plus()
    }
    if row <= 38 {
        return wide([132, 160], [132, 165], [132, 164], [132, 159])
    }
    if row <= 41 {
        return wide([168, 162], [168, 167], [168, 166], [168, 161])
    }
    if row <= 43 {
        return wide([166, 162], [166, 167], [166, 166], [166, 161])
    }
    if row <= 47 {
        return iso2022jp()
    }
    if row <= 84 {
        return ibm()
    }
    if row <= 86 {
        return wide([169, 166], [169, 192], [169, 184], [169, 164])
    }
    if row <= 88 {
        return utf8()
    }
    if row <= 90 {
        return wide([162, 120], [162, 117], [162, 124], [162, 119])
    }
    if row <= 92 {
        return ascii()
    }
    if row <= 95 {
        return koi8()
    }
    ascii()
}

/// The effective charset's name (`src/charset.c:130`): `--charset`/`-S`,
/// else `$TREE_CHARSET` (set but empty is still set), else `UTF-8` in a
/// UTF-8 locale; `has` false when none. XML's encoding attribute and
/// HTML's meta charset print it.
pub fn name(o: opts.Opts, utf8_locale: bool) -> (bool, str) {
    if o.has_charset {
        return (true, o.charset)
    }
    var have = true
    let cs = env_get("TREE_CHARSET") else |_| {
        have = false
        ""
    }
    if have {
        return (true, cs)
    }
    if utf8_locale {
        return (true, "UTF-8")
    }
    (false, "")
}

/// `src/charset.c:143`: `-A`, else the charset `name` answers, else
/// ASCII.
pub fn pick(o: opts.Opts, utf8_locale: bool) -> Lines {
    if o.ansilines {
        return ansi()
    }
    let (has, cs) = name(o, utf8_locale)
    if has {
        return for_charset(cs)
    }
    ascii()
}
