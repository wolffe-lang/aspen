//! member: false
//!
//! aspen — `tree(1)` in wolf: a port of tenseleyFlow/aspen (MIT, the
//! maintainer's), itself written with tree 2.3.2 (GPL-2.0-or-later) as
//! reference; this repository GPL-3.0-or-later (ruling #103). The entry
//! point (C aspen `src/main.c`): parse tree's command line, open `-o
//! FILE`, decide colour, pick the renderer, walk every root.

use clock
use color
use locale
use opts
use out
use std.time
use walk

/// Whether `--gitfile`/`--infofile`'s file can be read (tree's load).
fn readable(path: str) -> bool {
    var ok = true
    let _ = fs_read_bytes(path) else |_| {
        ok = false
        List[byte]()
    }
    ok
}

fn main() -> int {
    // C aspen's test-only hook, taken out before tree's parser sees the
    // words (`src/main.c:99`)
    var words = List[str]()
    var debug = false
    for a in env_args() {
        if a == "--asp-debug-walk" {
            debug = true
        } else {
            (mut words).push(a)
        }
    }
    let macos = opts.is_macos()
    let p = opts.parse(words, macos)
    var oks = List[bool]()
    for f in p.o.loads {
        (mut oks).push(readable(f))
    }
    let le = opts.load_error(p.o, oks)
    if le.len > 0 {
        var se = out.to_fd(2)
        out.s(mut se, le)
        out.flush(mut se)
        return 1
    }
    if p.stop >= 0 {
        var so = out.to_fd(1)
        out.s(mut so, p.out)
        out.flush(mut so)
        var se = out.to_fd(2)
        out.s(mut se, p.err)
        out.flush(mut se)
        return p.stop
    }
    var roots = copy p.roots
    if roots.len == 0 {
        (mut roots).push(".")
    }
    // -o FILE: the output to a file, diagnostics still on stderr; tree's
    // wording and status 1 when it cannot be opened (`src/main.c:125`)
    var fd = 1
    if p.o.has_outfile {
        var ok = true
        let f = fs_create(p.o.outfile) else |_| {
            ok = false
            0
        }
        if !ok {
            var se = out.to_fd(2)
            out.s(mut se, "aspen: invalid filename '{p.o.outfile}'\n")
            out.flush(mut se)
            return 1
        }
        fd = f
    }
    // colour (`options_finalize`, `src/main.c:77`): the text format's whole
    // decision, -H's -C alone (the CSS class needs the exec bit), never
    // for -J or -X
    var o = copy p.o
    var colors = color.off()
    if o.format == opts.out_html() {
        o.colorize = o.forcecolor
    } else if o.format == opts.out_unix() {
        let tty = os_isatty(fd) else false
        let (on, cs) = color.enabled(true, o.forcecolor, o.nocolor, tty)
        o.colorize = on
        if on {
            colors = color.parse(cs)
        }
    }
    let utf8 = locale.utf8_ctype()
    let zone = if o.dateflag then clock.local() else clock.utc()
    let now = time.unix_ms() / 1000
    let env = walk.Env {
        utf8: utf8,
        macos: macos,
        zone: zone,
        now: now,
        colors: colors,
        debug: debug,
    }
    var w = walk.make(o, fd, env)
    let status = walk.run(mut w, o, roots)
    if debug {
        var se = out.to_fd(2)
        out.s(mut se, "[debug] {w.dirs} directories, {w.files} files\n")
        out.flush(mut se)
    }
    if fd != 1 {
        fs_close(fd) else |_| {}
    }
    status
}
