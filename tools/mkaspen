#!/bin/sh
# mkaspen — aspen as a fully static x86-64 Linux executable, the shape PAX
# runs (pax's tools/mkpelt, lope's tools/mkstatic): the release tier, linked
# through a `cc` that adds `-static` (tools/build --static), checked to be
# ET_EXEC with no PT_INTERP, BUILT TWICE and refused unless both digests
# agree, and written to OUTDIR/sums.txt as `aspen <sha256> <bytes>`, with
# the stripped size beside it.
#
#   tools/mkaspen OUTDIR
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS x86-64-v4 glibc (px10).
set -eu
ASPEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
out=${1:?usage: mkaspen OUTDIR}
cd "$ASPEN_ROOT"
mkdir -p "$out"
digest() { sha256sum "$1" | cut -d' ' -f1; }
tools/build --static
cp target/static/aspen "$out/aspen.first"
tools/build --static
bin="$out/aspen"
cp target/static/aspen "$bin"
a=$(digest "$out/aspen.first")
b=$(digest "$bin")
rm -f "$out/aspen.first"
if [ "$a" != "$b" ]; then
    echo "mkaspen: REFUSED — two builds differ: $a, then $b" >&2
    exit 1
fi
readelf -hW "$bin" | grep -Eq 'Type: +EXEC' || { echo "mkaspen: $bin is not ET_EXEC" >&2; exit 1; }
if readelf -lW "$bin" | grep -q INTERP; then
    echo "mkaspen: $bin has a PT_INTERP (not static)" >&2
    exit 1
fi
"$bin" --version
bytes=$(wc -c <"$bin" | tr -d ' ')
strip -o "$out/aspen.stripped" "$bin"
sbytes=$(wc -c <"$out/aspen.stripped" | tr -d ' ')
printf 'aspen %s %s\n' "$b" "$bytes" | tee "$out/sums.txt"
printf 'aspen (built twice, the same digest); stripped: %s bytes, sha256 %s\n' "$sbytes" "$(digest "$out/aspen.stripped")"
printf 'linked against: %s\n' "$(cc -print-file-name=libc.a)"
