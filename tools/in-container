#!/bin/sh
# in-container — run a command in the oracle's container (ci/oracle.Containerfile)
# as the calling user, with the repository mounted at its own path, a
# private /tmp, and TZ=UTC. RULES §5: the oracle, the perf rows and every
# fixture with a FIFO or a 0000 directory run in here, never on a host.
#
#   tools/in-container COMMAND...
#
# podman (kasumi) or docker (CI, ASPEN_ENGINE=docker). The image is tagged by the
# Containerfile's own digest, so an edit to it builds a new one. Cores are
# off (`ulimit -c 0`): a rootless container's core lands in the HOST's
# store through its piped core_pattern, and tree 2.3.2 aborts on C aspen's
# 64 KiB --fromfile line (its own buffer overflow; notes/ap01-…).
set -eu
ASPEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# ASPEN_ENGINE picks one (CI sets docker: its runner has both)
eng=${ASPEN_ENGINE:-}
if [ -z "$eng" ]; then
    if command -v podman >/dev/null 2>&1; then
        eng=podman
    elif command -v docker >/dev/null 2>&1; then
        eng=docker
    else
        echo "in-container: no podman or docker" >&2
        exit 2
    fi
fi
if [ "$eng" = podman ]; then
    as_user="--userns=keep-id"
else
    as_user="--user $(id -u):$(id -g)"
fi
sum=$( (sha256sum "$ASPEN_ROOT/ci/oracle.Containerfile" 2>/dev/null || shasum -a 256 "$ASPEN_ROOT/ci/oracle.Containerfile") | cut -c1-12)
image=localhost/aspen-oracle:$sum
if ! $eng image inspect "$image" >/dev/null 2>&1; then
    echo "in-container: building $image" >&2
    $eng build -q -t "$image" -f "$ASPEN_ROOT/ci/oracle.Containerfile" "$ASPEN_ROOT/ci" >&2
fi
# shellcheck disable=SC2086
exec $eng run --rm $as_user -v "$ASPEN_ROOT:$ASPEN_ROOT" -w "$ASPEN_ROOT" \
    --tmpfs /tmp:rw,exec,size=4g -e TZ=UTC -e HOME=/tmp -e TMPDIR=/tmp \
    "$image" sh -c "ulimit -c 0; $*"
