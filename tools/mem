#!/bin/sh
# mem — the memory rows: the peak resident set of aspen and C aspen over
# the 100,000-file tree (tools/perf's tree100k), per flag set. Reported,
# not gated (notes/ap01-the-second-light.md §6 says why a region per level
# is not yet expressible in wolf).
#
#   tools/mem [--bin ASPEN] [--c-bin C_ASPEN]
#
# Run it in the oracle's container.
set -u
ASPEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
bin=$ASPEN_ROOT/target/release/aspen
cbin=$ASPEN_ROOT/.oracle/c-aspen/aspen
while [ $# -gt 0 ]; do
    case "$1" in
    --bin) bin=$2; shift 2 ;;
    --c-bin) cbin=$2; shift 2 ;;
    *) echo "mem: unknown argument $1" >&2; exit 2 ;;
    esac
done
for b in "$bin" "$cbin"; do
    [ -x "$b" ] || { echo "mem: no binary at $b" >&2; exit 2; }
done
work=$(mktemp -d "${TMPDIR:-/tmp}/aspen-mem.XXXXXX") || exit 2
trap 'rm -rf "$work"' EXIT INT TERM
python3 -I - "$work" <<'PY'
import os, sys
t = os.path.join(sys.argv[1], "tree100k")
for i in range(100):
    s = os.path.join(t, "d%03d" % i)
    os.makedirs(s)
    for j in range(1000):
        open(os.path.join(s, "f%04d" % j), "w").close()
PY
# the peak: wait4's rusage of a child a small C helper forks and execs
# (a helper of a few hundred KiB, so the fork's own pages do not count;
# the shape of C aspen's tests/golden/ptyrun.c, built here the same way)
cat >"$work/maxrss.c" <<'C'
#include <stdio.h>
#include <sys/resource.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <unistd.h>
int main(int argc, char **argv) {
    pid_t p = fork();
    if (p == 0) {
        int fd = open("/dev/null", O_WRONLY);
        dup2(fd, 1); dup2(fd, 2);
        execv(argv[1], argv + 1);
        _exit(127);
    }
    int st; struct rusage ru;
    if (wait4(p, &st, 0, &ru) < 0) return 2;
    printf("%ld\n", ru.ru_maxrss);
    return 0;
}
C
${CC:-cc} -O2 -o "$work/maxrss" "$work/maxrss.c" || { echo "mem: cannot build the helper" >&2; exit 2; }
peak() { # BIN ARGS...: the child's peak RSS in KiB
    "$work/maxrss" "$@"
}
for fl in "" "-s" "-J" "--du" "-pugsD"; do
    a=$(peak "$bin" $fl "$work/tree100k")
    c=$(peak "$cbin" $fl "$work/tree100k")
    printf 'mem: tree100k %-8s aspen %7s KiB  C aspen %7s KiB\n' "[${fl:-default}]" "$a" "$c"
done
