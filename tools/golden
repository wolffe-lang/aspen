#!/bin/sh
# golden — C aspen's golden suite, the oracle of record (ruling #103), run as
# it is against the wolf binary.
#
#   tools/golden [--bin ASPEN] [--c-aspen DIR]
#
# The pinned C aspen (aspen.pin; tools/fetch-c-aspen) is copied to a private
# directory, its files unedited; the wolf aspen is put where its scripts
# look (./aspen) and the distribution's tree 2.3.2 where build-ref.sh looks
# first (tests/.work/ref/tree-2.3.2), so nothing clones or builds tree's
# source. Then every script C aspen's own tests/run.sh runs against its
# binary runs as it is, in its order:
#
#   run.sh         the case matrix, in C, en_US.UTF-8 and C.UTF-8
#   walk.sh        discovery (via C aspen's --asp-debug-walk hook)
#   color.sh       -C and the colour environment, piped
#   pty.sh         colour on a real terminal (a PTY the script starts)
#   outfile.sh     -o FILE        rerun.sh     -R's 00Tree.html files
#   cyclic.sh      -l's cycle set over 30 inode layouts
#   adversarial.sh hostile inputs (a lone-backslash .gitignore, a 64 KiB
#                  --fromfile line, a 600 KB TREE_COLORS)
#   patterns.sh    -P/-I paths    fpath.sh     -f roots
#   usage.sh       --help and bad command lines
#   fdlimit.sh     a 250-deep chain under a low fd limit
#   threads.sh     --threads 1 == 16 == tree, the pool's dead zone
#   deviations.sh  the law where C aspen and tree disagree
#   structural.sh  -J/-X well-formed
#
# (flag_coverage.sh lints C aspen's own src/options.c, and fuzz.sh is
# tools/fuzz.) color.sh and pty.sh list tests/.work's corpus, meta, lnk
# and weird fixtures, of which C aspen's runner makes only the corpus
# (walk.sh does); here all four are made first, by C aspen's own
# generators, so the colour rows list real trees.
#
# Each script's reports are classed: a report about an implemented flag
# set in the C or C.UTF-8 locale must not exist (a STOP); one about a
# refused flag (--acl, --selinux: lib-classify.sh), or any
# under en_US.UTF-8 (whose strcoll order aspen does not carry;
# src/locale), is "not yet"; a script's own skip is printed and counted.
# For run.sh, every case is counted: N agree / M differ / K not-yet.
# Prints the counts; exit 1 when a STOP report exists, 2 when it cannot run.
#
# Run it in the oracle's container, as a non-root user.
set -u
ASPEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
bin=$ASPEN_ROOT/target/release/aspen
csrc=$ASPEN_ROOT/.oracle/c-aspen
while [ $# -gt 0 ]; do
    case "$1" in
    --bin) bin=$2; shift 2 ;;
    --c-aspen) csrc=$2; shift 2 ;;
    *) echo "golden: unknown argument $1" >&2; exit 2 ;;
    esac
done
case "$bin" in /*) ;; *) bin=$(pwd)/$bin ;; esac
[ -x "$bin" ] || { echo "golden: no aspen at $bin" >&2; exit 2; }
[ -f "$csrc/tests/golden/run.sh" ] || { echo "golden: no C aspen at $csrc (tools/fetch-c-aspen)" >&2; exit 2; }
tv=$(tree --version 2>/dev/null | head -1)
case "$tv" in
"tree v2.3.2 "*) ;;
*) echo "golden: REFUSED — tree is '$tv', the oracle is tree v2.3.2" >&2; exit 2 ;;
esac
. "$ASPEN_ROOT/tools/lib-classify.sh"

work=$(mktemp -d "${TMPDIR:-/tmp}/aspen-golden.XXXXXX") || exit 2
trap 'chmod -R u+rwx "$work" 2>/dev/null; rm -rf "$work"' EXIT INT TERM
g=$work/c-aspen
mkdir -p "$g"
(cd "$csrc" && tar -cf - --exclude=.git --exclude=./aspen --exclude=./asp --exclude=./tests/.work --exclude='*.o' --exclude='*.d' .) | (cd "$g" && tar -xf -)
cp "$bin" "$g/aspen"
mkdir -p "$g/tests/.work/ref"
cp "$(command -v tree)" "$g/tests/.work/ref/tree-2.3.2"
cd "$g" || exit 2

agree=0
differ=0
notyet=0
coll=0
skips=0

# --- run.sh: every case of the matrix ------------------------------------
sh tests/golden/run.sh >"$work/run.out" 2>"$work/run.err"
runrc=$?
cases=$(sed -n "/^CASES='/,/'\$/p" tests/golden/run.sh | sed "1s/^CASES='//; \$s/'\$//")
locales=$(sed -n 's/^GOLDEN: locales = //p' "$work/run.out" "$work/run.err" | head -1)
echo "golden: run.sh (exit $runrc), locales: $locales"
grep -E '^(self-test|parity)' "$work/run.err" | sed 's/^/  /'
nl='
'
oldifs=$IFS
for lc in $locales; do
    IFS=$nl
    for c in $cases; do
        IFS=$oldifs
        [ -n "$c" ] || continue
        cls=$(classify "$c")
        if grep -qxF "  DIFF [parity(aspen-vs-ref)/$lc]: $c" "$work/run.out"; then
            if [ "$cls" = v1 ] && [ "$lc" != en_US.UTF-8 ] && [ "$lc" != en_US.utf8 ]; then
                differ=$((differ + 1))
                echo "  DIFF v1 [$lc]: $c"
            else
                notyet=$((notyet + 1))
                if [ "$cls" = v1 ]; then
                    coll=$((coll + 1))
                    echo "  not-yet (en_US.UTF-8 collation, src/locale): $c"
                fi
            fi
        else
            agree=$((agree + 1))
        fi
        IFS=$nl
    done
    IFS=$oldifs
done
if grep -q 'self-test FAILED' "$work/run.out"; then
    echo "golden: run.sh's own self-test failed (tree against tree): the harness, not aspen" >&2
    exit 2
fi
echo "golden: run.sh matrix: $agree agree / $differ differ / $notyet not-yet ($coll of them v1 cases under en_US.UTF-8)"

# --- the other scripts: their failure reports, classed --------------------
# a report line names its flags in [brackets] or after the script's tag;
# the v2 words it may name are the ones classify knows
other() { # script, tag
    _s=$1 _tag=$2
    sh "tests/golden/$_s" >"$work/$_s.out" 2>&1
    _rc=$?
    _v1=0
    _v2=0
    while IFS= read -r _l; do
        case "$_l" in
        "$_tag"*) ;;
        *) continue ;;
        esac
        _k=$(classify_report "$_s" "$_l")
        case "$_k" in
        ok) ;;
        skip) skips=$((skips + 1)); echo "  $_s SKIP: $_l" ;;
        v1) _v1=$((_v1 + 1)); echo "  $_s v1: $_l" ;;
        *) _v2=$((_v2 + 1)) ;;
        esac
    done <"$work/$_s.out"
    differ=$((differ + _v1))
    notyet=$((notyet + _v2))
    echo "golden: $_s (exit $_rc): $_v1 STOP report(s), $_v2 not-yet report(s); last line: $(tail -1 "$work/$_s.out")"
}
other walk.sh "WALK:"
# the colour scripts' fixtures, made by C aspen's own generators
for _f in corpus meta lnk weird; do
    [ -d "tests/.work/$_f" ] || sh "tests/golden/mk$_f.sh" "tests/.work/$_f" >/dev/null
done
other color.sh "COLOR"
other pty.sh "PTY"
other outfile.sh "OUTFILE:"
other rerun.sh "RERUN"
other cyclic.sh "CYCLIC"
other adversarial.sh "ADVERSARIAL"
other patterns.sh "PATTERNS"
other fpath.sh "FPATH"
other usage.sh "USAGE:"
other fdlimit.sh "FDLIMIT:"
other threads.sh "THREADS"
other deviations.sh "DEVIATIONS"
other structural.sh "STRUCT"

echo "golden: $agree agree / $differ differ / $notyet not-yet ($skips skip(s))"
[ "$differ" = 0 ]
